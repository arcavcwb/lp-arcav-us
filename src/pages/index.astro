---
export const prerender = true;

import Layout from '@layouts/Layout.astro';
import { Footer, Header } from '@components/ui';
import { Contact, Examples, Hero, Method, Problem, Services } from '@components/home';
import { ANCHOR, footerNav, home, mainNav, ui } from '@data';

const canonical = new URL('/', Astro.site).href;
---
<Layout title={home.meta.title} description={home.meta.description} canonical={canonical}>
  <Header links={mainNav()} cta={{ label: ui.header.cta, popover: ANCHOR.contactForm }} />
  <main id={ANCHOR.content}>
    <Hero />
    <Services />
    <Examples />
    <Problem />
    <Method />
    <Contact />
  </main>
  <Footer links={footerNav({ fromHome: true })} />
</Layout>
