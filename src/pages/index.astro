---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Header from '../components/ui/Header.astro';
import Footer from '../components/ui/Footer.astro';
import Hero from '../components/home/Hero.astro';
import Services from '../components/home/Services.astro';
import Examples from '../components/home/Examples.astro';
import Problem from '../components/home/Problem.astro';
import Method from '../components/home/Method.astro';
import About from '../components/home/About.astro';
import Contact from '../components/home/Contact.astro';
import { home } from '../data/site';
import { ANCHOR, toAnchor } from '../data/anchors';
import { footerNav, mainNav } from '../data/navigation';
import { ui } from '../data/ui';

const nav = mainNav();
const canonical = new URL('/', Astro.site).href;
---
<Layout title={home.meta.title} description={home.meta.description} canonical={canonical}>
  <Header links={nav} cta={{ href: toAnchor(ANCHOR.contact), label: ui.header.cta }} />
  <main id={ANCHOR.content}>
    <Hero />
    <Services />
    <Examples />
    <Problem />
    <Method />
    <About />
    <Contact />
  </main>
  <Footer links={footerNav({ fromHome: true })} />
</Layout>
