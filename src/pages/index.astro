---
// Detecta el idioma y redirige a /es/, /pt/ o /en/ en un solo salto.
// Prioridad: 1) cookie de elección manual  2) idioma del navegador  3) español.
export const prerender = false;

const LOCALES = ['es', 'pt', 'en'];
const DEFAULT_LOCALE = 'es';

const cookieLang = Astro.cookies.get('arcav_lang')?.value;
let target: string | null = cookieLang && LOCALES.includes(cookieLang) ? cookieLang : null;

if (!target) {
  const prefs = (Astro.request.headers.get('accept-language') ?? '')
    .split(',')
    .map((part) => part.split(';')[0].trim().toLowerCase().split('-')[0]);
  target = prefs.find((p) => LOCALES.includes(p)) ?? null;
}

return Astro.redirect(`/${target ?? DEFAULT_LOCALE}/`, 302);
---
