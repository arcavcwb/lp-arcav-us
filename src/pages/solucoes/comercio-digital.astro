---
export const prerender = true;

import Layout from '@layouts/Layout.astro';
import { ClosingContact, Faq, Footer, Header, Icon, OrderMessage, PhoneDemo, RuledPoints } from '@components/ui';
import { ANCHOR, commerceService as page, footerNav, toAnchor } from '@data';
import { solutionTransition } from '@lib';

const canonical = new URL(page.path, Astro.site).href;
---
<Layout title={page.meta.title} description={page.meta.description} canonical={canonical}>
  <Header cta={{ label: page.hero.cta, popover: ANCHOR.contactForm }} />

  <main id={ANCHOR.content}>
    <section class="page-hero" aria-labelledby="hero-title">
      <div class="shell page-hero__grid">
        <div>
          <h1 class="h1" id="hero-title" style={solutionTransition('comercio-digital')}>{page.hero.title}</h1>
          <p class="lead">{page.hero.subtitle}</p>
          <div class="page-hero__actions">
            <button class="btn btn--primary" type="button" popovertarget={ANCHOR.contactForm}>
              {page.hero.cta}
              <Icon name="arrow-right" />
            </button>
            <a class="btn btn--ghost" href={toAnchor(ANCHOR.demo)}>{page.hero.demoCta}</a>
          </div>
          <p class="small hero-note">{page.hero.note}</p>
        </div>
        <PhoneDemo
            id={ANCHOR.demo}
            products={page.demo.products}
            caption={page.demo.caption}
            next={page.demo.next}
            guide
          />
      </div>
    </section>

    <section class="section" aria-labelledby="frentes-title">
      <div class="shell">
        <div class="section-head">
          <h2 class="h2" id="frentes-title">{page.pillars.title}</h2>
        </div>
        <RuledPoints items={page.pillars.items} />
      </div>
    </section>

    <section class="section section--muted commerce-example" id="exemplo" aria-labelledby="exemplo-title">
      <div class="shell commerce-example__grid">
        <div>
          <h2 class="h2" id="exemplo-title">{page.example.title}</h2>
          <p class="lead commerce-example__lead">{page.example.text}</p>
          <button class="btn btn--primary commerce-example__cta" type="button" popovertarget={ANCHOR.contactForm}>
            {page.hero.cta}
            <Icon name="arrow-right" />
          </button>
        </div>
        <OrderMessage order={page.example.order} live={page.example.live} />
      </div>
    </section>

    <section class="section" aria-labelledby="processo-title">
      <div class="shell">
        <div class="section-head">
          <h2 class="h2" id="processo-title">{page.process.title}</h2>
        </div>
        <ol class="steps steps--4 steps--text">
          {page.process.steps.map((step) => (
            <li><p>{step}</p></li>
          ))}
        </ol>
      </div>
    </section>

    <Faq title={page.faq.title} items={page.faq.items} />

    <ClosingContact
      title={page.closing.title}
      text={page.closing.text}
      subject={page.closing.contactSubject}
      variant="store"
      waMessage={page.closing.contactMessage}
    />
  </main>

  <Footer links={footerNav()} />
</Layout>
