---
export const prerender = true;

import { SolutionPage } from '@components/solution';
import { DEDICATED_PAGES, SOLUTIONS } from '@data';

export function getStaticPaths() {
  // As soluções com página própria (DEDICATED_PAGES) não passam por esta rota.
  return SOLUTIONS.filter((s) => !DEDICATED_PAGES.includes(s.slug)).map((solution) => ({
    params: { slug: solution.slug },
    props: { solution },
  }));
}

const { solution } = Astro.props;
---
<SolutionPage solution={solution} />
