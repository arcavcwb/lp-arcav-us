---
export const prerender = true;

import SolutionPage from '../../components/solution/SolutionPage.astro';
import { SOLUTIONS } from '../../data/solutions';

export function getStaticPaths() {
  // Comércio e Landing pages têm arquivo próprio (comercio-digital.astro, landing-pages.astro).
  return SOLUTIONS.filter((s) => !['comercio-digital', 'landing-pages'].includes(s.slug)).map((solution) => ({
    params: { slug: solution.slug },
    props: { solution },
  }));
}

const { solution } = Astro.props;
---
<SolutionPage solution={solution} />
