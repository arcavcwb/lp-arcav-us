---
import type { Copy } from '../i18n/translations';

interface Props {
  copy: Copy['about'];
}

const { copy } = Astro.props;

const TOOLKIT = [
  "TypeScript", "React", "Astro", "Node.js", "NestJS", 
  "Supabase", "n8n", "Docker", "Cloudflare", "PostgreSQL"
];
---
<section id="sobre-mi" class="section about-section">
  <div class="container">

    <div class="about-grid">

      <!-- Text Column -->
      <div class="about-content">
        <div class="mono-label">{copy.label}</div>
        <h2 class="section-title">{copy.title}</h2>
        <p class="about-text">{copy.copy}</p>

        <!-- Trajectory Map Card -->
        <div class="card trajectory-card">
          <span class="trajectory-title">TRAYECTORIA INTERNACIONAL:</span>
          <div class="trajectory-nodes">
            <span class="node-city">Venezuela</span>
            <span class="node-arrow">➔</span>
            <span class="node-city">México <small>(Arkus Nexus)</small></span>
            <span class="node-arrow">➔</span>
            <span class="node-city">San Diego / USA <small>(Drata)</small></span>
            <span class="node-arrow">➔</span>
            <span class="node-city active-city">Brasil <small>(Curitiba)</small></span>
          </div>
        </div>

        <p class="about-statement">"{copy.statement}"</p>
      </div>

      <!-- Toolkit Column -->
      <div class="card toolkit-card">
        <h3 class="toolkit-title">Herramientas & Ecosistema</h3>
        <p class="toolkit-desc">Stack flexible orientado al problema de negocio:</p>

        <div class="tools-grid">
          {TOOLKIT.map(tool => (
            <span class="mono-tag tool-tag">{tool}</span>
          ))}
        </div>
      </div>

    </div>

  </div>
</section>

<style>
.about-section {
  background: var(--bg-deep);
}

.about-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 3.5rem;
}

@media (min-width: 900px) {
  .about-grid {
    grid-template-columns: 1.2fr 0.8fr;
    gap: 4rem;
  }
}

.about-content {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.about-text {
  font-size: 1.1rem;
  color: var(--text-muted);
  line-height: 1.7;
}

.trajectory-card {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  border-color: var(--border-subtle);
  background: var(--surface-main);
  padding: 1.5rem;
}

.trajectory-title {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  color: var(--coral-light);
  font-weight: 700;
  letter-spacing: 0.1em;
}

.trajectory-nodes {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.5rem;
  font-family: var(--font-mono);
  font-size: 0.85rem;
}

.node-city {
  color: var(--text-main);

  small {
    color: var(--text-subtle);
    font-size: 0.75rem;
  }
}

.active-city {
  color: var(--emerald-light);
  font-weight: 700;
}

.node-arrow {
  color: var(--coral);
}

.about-statement {
  font-family: var(--font-display);
  font-size: 1.1rem;
  font-style: italic;
  color: var(--text-main);
  border-left: 3px solid var(--coral);
  padding-left: 1rem;
}

.toolkit-card {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
  height: fit-content;
}

.toolkit-title {
  font-size: 1.25rem;
  font-weight: 700;
}

.toolkit-desc {
  font-size: 0.9rem;
  color: var(--text-subtle);
}

.tools-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.tool-tag {
  font-size: 0.8rem;
  padding: 0.4rem 0.75rem;
  background: var(--bg-deep);

  &:hover {
    border-color: var(--border-active);
    color: var(--text-main);
  }
}
</style>
