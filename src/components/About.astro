---
import { BRAND, type Copy } from '../i18n/translations';

interface Props {
  about: Copy['about'];
}

const { about } = Astro.props;
---
<section id="quien-soy" class="about" aria-labelledby="about-title">
  <div class="wrap about__grid">
    <div class="about__text">
      <h2 id="about-title">{about.title}</h2>
      {about.paragraphs.map((p) => <p>{p}</p>)}
      <p class="about__motto">{about.motto}</p>
      <p class="about__method">
        {about.method}
        <a href={BRAND.method} target="_blank" rel="noopener noreferrer">{about.methodLink}</a>
      </p>
    </div>

    <figure class="route">
      <figcaption class="visually-hidden">{about.routeLabel}</figcaption>
      <ol>
        {about.route.map((stop, i) => (
          <li class:list={{ 'route__end': i === about.route.length - 1 }}>
            <span class="route__place">{stop.place}</span>
            <span class="route__note">{stop.note}</span>
          </li>
        ))}
      </ol>
    </figure>
  </div>
</section>

<style>
  .about {
    padding-block: var(--space-9);
  }

  .about__grid {
    display: grid;
    gap: var(--space-8);
  }

  @media (min-width: 960px) {
    .about__grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
      align-items: start;
    }
  }

  .about__text {
    display: grid;
    gap: var(--space-4);
    max-width: 40rem;
  }

  .about__text h2 {
    margin-bottom: var(--space-3);
  }

  .about__motto {
    margin-top: var(--space-4);
    font-family: var(--font-sign);
    font-weight: 800;
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    line-height: 1.02;
  }

  .about__method {
    color: var(--ink-soft);
  }

  .about__method a {
    font-family: var(--font-sign);
    font-weight: 600;
    font-size: 1.2rem;
    color: var(--ink);
    margin-left: 0.3rem;
    white-space: nowrap;
  }

  .route {
    display: grid;
    gap: var(--space-5);
  }

  .route ol {
    position: relative;
    display: grid;
    gap: var(--space-6);
    padding: 0 0 0 3.2rem;
    list-style: none;
  }

  .route ol::before {
    content: '';
    position: absolute;
    left: 0.85rem;
    top: 0.6rem;
    bottom: 0.9rem;
    width: 10px;
    background: repeating-linear-gradient(to bottom, var(--ink) 0 18px, transparent 18px 26px);
  }

  .route li {
    position: relative;
    display: grid;
    gap: 0.1rem;
  }

  .route li::before {
    content: '';
    position: absolute;
    left: -2.85rem;
    top: 0.25rem;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: var(--paper);
    border: 5px solid var(--ink);
  }

  .route__end::before {
    background: var(--here) !important;
    width: 1.9rem !important;
    height: 1.9rem !important;
    left: -3.05rem !important;
    top: 0.1rem !important;
  }

  .route__place {
    font-family: var(--font-sign);
    font-weight: 800;
    font-size: 1.7rem;
    line-height: 1.05;
  }

  .route__note {
    font-family: var(--font-sign);
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--ink-soft);
  }
</style>
