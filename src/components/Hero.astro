---
import type { Copy } from '../i18n/translations';
import NetworkMap from './NetworkMap.astro';

interface Props {
  hero: Copy['hero'];
  lineNames: Copy['lineNames'];
}

const { hero, lineNames } = Astro.props;
---
<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero__grid">
    <div class="hero__board">
      <div class="nameboard">
        <h1 id="hero-title">{hero.title}</h1>
      </div>
      <p class="hero__lead">{hero.lead}</p>
      <div class="hero__actions">
        <a class="board-button" href="#contacto">
          {hero.cta}
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" /></svg>
        </a>
        <p class="hero__note">{hero.ctaNote}</p>
      </div>
      <a class="hero__secondary" href="#proyectos">{hero.secondary}</a>
    </div>

    <NetworkMap map={hero.map} lineNames={lineNames} />
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2rem, 5vw, 4.25rem) clamp(1.5rem, 3vw, 2.5rem);
  }

  .hero__grid {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }

  @media (min-width: 1080px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-6);
    }
  }

  .hero__board {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }

  /* Placa de nombre de estación */
  .nameboard {
    position: relative;
    width: 100%;
    padding: clamp(1.1rem, 2.2vw, 1.7rem) clamp(1.2rem, 2.4vw, 1.9rem) clamp(2.1rem, 3.4vw, 2.8rem);
    background: var(--ink);
    color: var(--paper);
  }

  .nameboard::after {
    content: '';
    position: absolute;
    left: clamp(1.2rem, 2.4vw, 1.9rem);
    bottom: clamp(0.8rem, 1.4vw, 1.1rem);
    width: min(12rem, 45%);
    height: 9px;
    border-radius: 5px;
    background: linear-gradient(90deg, var(--line-landing) 0 33.33%, var(--line-sistema) 33.33% 66.66%, var(--line-auto) 66.66% 100%);
  }

  h1 {
    font-size: clamp(2.5rem, 4.1vw, 3.7rem);
    line-height: 0.95;
    text-wrap: balance;
  }

  :global(html[lang='en']) h1 {
    font-size: clamp(2.1rem, 3.3vw, 3.1rem);
  }

  /* En pantallas angostas el titular escala con el ancho para no dejar palabras sueltas */
  @media (max-width: 479px) {
    h1 {
      font-size: clamp(1.9rem, 10.2vw, 2.5rem);
    }

    :global(html[lang='en']) h1 {
      font-size: clamp(1.45rem, 7.4vw, 1.85rem);
    }
  }

  .hero__lead {
    font-size: clamp(1.15rem, 1.6vw, 1.3rem);
    color: var(--ink-soft);
    max-width: 34rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    margin-top: var(--space-2);
  }

  .hero__note {
    font-family: var(--font-sign);
    font-weight: 600;
    font-size: 1.15rem;
    color: var(--ink-soft);
  }

  .hero__secondary {
    font-family: var(--font-sign);
    font-weight: 600;
    font-size: 1.2rem;
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
  }
</style>
