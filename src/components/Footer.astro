---
import { BRAND, LANGS, type Copy, type Lang, type LineId } from '../i18n/translations';
import Roundel from './Roundel.astro';

interface Props {
  footer: Copy['footer'];
  lineNames: Copy['lineNames'];
  lang: Lang;
  languageLabel: string;
}

const { footer, lineNames, lang, languageLabel } = Astro.props;
const order: LineId[] = ['landing', 'sistema', 'auto'];
---
<footer class="footer">
  <div class="wrap footer__grid">
    <div class="footer__brand">
      <p class="footer__name">ARCAV <span>by Armando Castro</span></p>
      <p>{footer.tagline}</p>
      <p>{footer.location}</p>
    </div>

    <div class="footer__legend">
      <ul aria-label={footer.legend}>
        {order.map((id) => (
          <li><a href={`#servicio-${id}`}><Roundel line={id} label={lineNames[id]} size="sm" /><span aria-hidden="true">{lineNames[id]}</span></a></li>
        ))}
      </ul>
    </div>

    <div class="footer__links">
      <ul>
        <li><a href={BRAND.github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
        <li><a href={BRAND.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
      </ul>
      <ul aria-label={languageLabel}>
        {LANGS.map((l) => (
          <li><a href={l.path} hreflang={l.code} lang={l.code} aria-current={l.code === lang ? 'page' : undefined}>{l.name}</a></li>
        ))}
      </ul>
    </div>
  </div>
  <div class="wrap footer__base">
    <p>{footer.rights}</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink);
    color: var(--paper);
    padding-block: var(--space-8) var(--space-6);
  }

  .footer a {
    color: var(--paper);
  }

  .footer__grid {
    display: grid;
    gap: var(--space-7);
  }

  @media (min-width: 900px) {
    .footer__grid {
      grid-template-columns: 1.2fr 1fr 1fr;
    }
  }

  .footer__brand {
    display: grid;
    gap: var(--space-1);
    color: #c9ced3;
  }

  .footer__name {
    font-family: var(--font-sign);
    font-weight: 800;
    font-size: 2.2rem;
    line-height: 1;
    color: var(--paper);
    margin-bottom: var(--space-2);
  }

  .footer__name span {
    font-weight: 600;
    font-size: 1.15rem;
    color: #c9ced3;
  }

  .footer ul {
    display: grid;
    align-content: start;
    gap: var(--space-1);
    padding: 0;
    list-style: none;
  }

  .footer__legend a,
  .footer__links a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.5rem;
    font-family: var(--font-sign);
    font-weight: 600;
    font-size: 1.2rem;
    text-decoration: none;
  }

  .footer__legend a:hover,
  .footer__links a:hover {
    text-decoration: underline;
    text-decoration-color: var(--here);
    text-decoration-thickness: 3px;
  }

  .footer__links {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
    align-content: start;
  }

  .footer__links a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--here);
    text-decoration-thickness: 3px;
  }

  .footer :focus-visible {
    outline-color: var(--here);
    box-shadow: none;
  }

  .footer__base {
    margin-top: var(--space-7);
    padding-top: var(--space-4);
    border-top: 2px solid #3a3f45;
    color: #aab1b8;
    font-size: 1rem;
  }
</style>
