---
import { BRAND, type Copy } from '../i18n/translations';

interface Props {
  copy: Copy['footer'];
}

const { copy } = Astro.props;
---
<footer class="footer">
  <div class="container footer-content">

    <div class="footer-brand">
      <span class="brand-title">{BRAND.name}</span>
      <span class="brand-sub">by {BRAND.author}</span>
      <p class="brand-tagline">{BRAND.tagline}</p>
    </div>

    <div class="footer-meta">
      <div class="meta-item">
        <span class="mono-label">UBICACIÓN:</span>
        <span class="meta-val">{copy.location}</span>
      </div>

      <div class="meta-item">
        <span class="mono-label">TRAYECTORIA:</span>
        <span class="meta-val">{copy.trajectory}</span>
      </div>
    </div>

    <div class="footer-links">
      {BRAND.social.map(s => (
        <a href={s.href} target="_blank" rel="noopener noreferrer" class="social-link">
          {s.name} ↗
        </a>
      ))}
    </div>

  </div>

  <div class="container footer-bottom">
    <p class="copyright-text">{copy.copyright}</p>
  </div>
</footer>

<style>
.footer {
  background: var(--bg-deep);
  border-top: 1px solid var(--border-subtle);
  padding: 4rem 0 2rem;
}

.footer-content {
  display: grid;
  grid-template-columns: 1fr;
  gap: 2.5rem;
  padding-bottom: 3rem;
  border-bottom: 1px solid var(--border-subtle);
}

@media (min-width: 768px) {
  .footer-content {
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: 3rem;
  }
}

.footer-brand {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.brand-title {
  font-family: var(--font-display);
  font-size: 1.5rem;
  font-weight: 900;
}

.brand-sub {
  font-family: var(--font-mono);
  font-size: 0.8rem;
  color: var(--coral-light);
}

.brand-tagline {
  font-size: 0.9rem;
  color: var(--text-muted);
  margin-top: 0.5rem;
}

.footer-meta {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.meta-item {
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
}

.meta-val {
  font-family: var(--font-mono);
  font-size: 0.85rem;
  color: var(--text-main);
}

.footer-links {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.social-link {
  font-family: var(--font-mono);
  font-size: 0.85rem;
  color: var(--blue-light);
  transition: color var(--transition-fast);
}

.social-link:hover {
  color: var(--coral);
}

.footer-bottom {
  padding-top: 2rem;
  text-align: center;
}

.copyright-text {
  font-family: var(--font-mono);
  font-size: 0.8rem;
  color: var(--text-subtle);
}
</style>
