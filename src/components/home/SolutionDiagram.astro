---
// Esquema de cada solução, em linha (geometria, não ilustração). O elemento terracota é sempre
// onde a ação acontece. Partes com .d-draw se desenham ao aparecer; .d-move/.d-travel animam no hover.
interface Props {
  slug: string;
}

const { slug } = Astro.props;
---
<svg class="diagram" viewBox="0 0 200 120" role="img" aria-hidden="true" focusable="false">
  {slug === 'landing-page-alto-padrao' && (
    <g>
      <rect class="d-frame" x="10" y="10" width="180" height="100" rx="6" />
      <line class="d-line" x1="10" y1="22" x2="190" y2="22" />
      <rect class="d-ink" x="22" y="34" width="72" height="7" rx="1.5" />
      <rect class="d-ink" x="22" y="46" width="56" height="7" rx="1.5" />
      <rect class="d-soft" x="22" y="62" width="64" height="3" rx="1.5" />
      <rect class="d-soft" x="22" y="69" width="50" height="3" rx="1.5" />
      <rect class="d-accent d-move" x="22" y="82" width="34" height="11" rx="3" />
      <rect class="d-panel" x="108" y="32" width="70" height="66" rx="3" />
      <polygon class="d-light d-move-light" points="112,36 150,36 174,94 112,94" />
      <line class="d-draw" x1="112" y1="80" x2="174" y2="80" />
      <line class="d-draw" x1="160" y1="44" x2="160" y2="80" />
    </g>
  )}
  {slug === 'landing-page-campanhas' && (
    <g>
      <rect class="d-frame" x="10" y="30" width="54" height="60" rx="5" />
      <rect class="d-soft" x="18" y="40" width="38" height="22" rx="2" />
      <rect class="d-ink" x="18" y="68" width="30" height="4" rx="1.5" />
      <rect class="d-soft" x="18" y="76" width="22" height="3" rx="1.5" />
      <path class="d-draw d-arrow" d="M70 60 H96 M90 54 l6 6 -6 6" />
      <rect class="d-frame" x="104" y="12" width="86" height="96" rx="6" />
      <rect class="d-ink" x="114" y="24" width="52" height="6" rx="1.5" />
      <rect class="d-field" x="114" y="40" width="66" height="10" rx="2" />
      <rect class="d-field" x="114" y="55" width="66" height="10" rx="2" />
      <rect class="d-field" x="114" y="70" width="66" height="10" rx="2" />
      <rect class="d-accent d-move" x="114" y="86" width="66" height="12" rx="3" />
    </g>
  )}
  {slug === 'landing-page-produto' && (
    <g>
      <rect class="d-frame" x="10" y="10" width="180" height="100" rx="6" />
      <rect class="d-ink" x="22" y="30" width="62" height="7" rx="1.5" />
      <rect class="d-ink" x="22" y="42" width="48" height="7" rx="1.5" />
      <rect class="d-soft" x="22" y="58" width="58" height="3" rx="1.5" />
      <rect class="d-accent" x="22" y="72" width="36" height="11" rx="3" />
      <rect class="d-device" x="112" y="18" width="46" height="86" rx="8" />
      <rect class="d-soft" x="119" y="32" width="32" height="8" rx="2" />
      <rect class="d-soft" x="119" y="44" width="32" height="8" rx="2" />
      <rect class="d-soft" x="119" y="56" width="32" height="8" rx="2" />
      <rect class="d-soft" x="119" y="68" width="32" height="8" rx="2" />
      <g class="d-move">
        <rect class="d-card" x="140" y="50" width="44" height="18" rx="3" />
        <circle class="d-dot-accent" cx="149" cy="59" r="3" />
        <rect class="d-soft" x="156" y="56" width="22" height="3" rx="1.5" />
        <rect class="d-soft" x="156" y="61" width="14" height="3" rx="1.5" />
      </g>
    </g>
  )}
  {slug === 'landing-page-palestras' && (
    <g>
      <rect class="d-frame" x="10" y="10" width="180" height="100" rx="6" />
      <rect class="d-ink" x="22" y="26" width="98" height="12" rx="2" />
      <rect class="d-ink" x="22" y="43" width="76" height="12" rx="2" />
      <rect class="d-soft" x="22" y="64" width="70" height="3" rx="1.5" />
      <rect class="d-soft" x="22" y="71" width="54" height="3" rx="1.5" />
      <rect class="d-accent d-move" x="22" y="84" width="44" height="12" rx="3" />
      <rect class="d-panel" x="132" y="26" width="46" height="50" rx="3" />
      <rect class="d-ink" x="140" y="34" width="14" height="22" rx="1.5" />
      <rect class="d-soft" x="158" y="36" width="14" height="4" rx="1.5" />
      <rect class="d-soft" x="158" y="44" width="10" height="4" rx="1.5" />
      <line class="d-draw" x1="132" y1="88" x2="178" y2="88" />
      <circle class="d-dot" cx="138" cy="88" r="2.5" />
      <circle class="d-dot" cx="155" cy="88" r="2.5" />
      <circle class="d-dot-accent" cx="172" cy="88" r="2.5" />
    </g>
  )}
  {slug === 'comercio-digital' && (
    <g>
      <rect class="d-frame" x="10" y="18" width="66" height="84" rx="6" />
      <rect class="d-soft" x="18" y="28" width="22" height="20" rx="2" />
      <rect class="d-soft" x="46" y="28" width="22" height="20" rx="2" />
      <rect class="d-soft" x="18" y="54" width="22" height="20" rx="2" />
      <rect class="d-soft" x="46" y="54" width="22" height="20" rx="2" />
      <rect class="d-ink" x="18" y="82" width="50" height="10" rx="2.5" />
      <path class="d-draw" d="M82 60 H118" />
      <circle class="d-travel" cx="82" cy="60" r="3.5" />
      <path class="d-bubble" d="M124 34 h58 a6 6 0 0 1 6 6 v34 a6 6 0 0 1 -6 6 h-44 l-10 8 v-8 h-4 a6 6 0 0 1 -6 -6 v-34 a6 6 0 0 1 6 -6 z" />
      <rect class="d-soft" x="132" y="44" width="40" height="3" rx="1.5" />
      <rect class="d-ink" x="132" y="52" width="46" height="4" rx="1.5" />
      <rect class="d-ink" x="132" y="60" width="36" height="4" rx="1.5" />
      <rect class="d-accent" x="132" y="68" width="22" height="5" rx="1.5" />
    </g>
  )}
  {slug === 'sistemas-e-automacao' && (
    <g>
      <path class="d-draw" d="M46 60 H86 M118 60 H154" />
      <circle class="d-travel" cx="46" cy="60" r="3.5" />
      <rect class="d-frame" x="10" y="38" width="36" height="44" rx="5" />
      <rect class="d-field" x="16" y="48" width="24" height="6" rx="1.5" />
      <rect class="d-field" x="16" y="58" width="24" height="6" rx="1.5" />
      <rect class="d-ink" x="16" y="69" width="24" height="6" rx="1.5" />
      <rect class="d-frame" x="86" y="34" width="32" height="52" rx="4" />
      <line class="d-line" x1="86" y1="47" x2="118" y2="47" />
      <line class="d-line" x1="86" y1="60" x2="118" y2="60" />
      <line class="d-line" x1="86" y1="73" x2="118" y2="73" />
      <line class="d-line" x1="100" y1="34" x2="100" y2="86" />
      <rect class="d-accent-soft d-move" x="86" y="73" width="32" height="13" />
      <path class="d-bubble" d="M154 40 h30 a6 6 0 0 1 6 6 v18 a6 6 0 0 1 -6 6 h-18 l-8 7 v-7 h-4 a6 6 0 0 1 -6 -6 v-18 a6 6 0 0 1 6 -6 z" />
      <rect class="d-ink" x="160" y="50" width="22" height="3.5" rx="1.5" />
      <rect class="d-accent" x="160" y="57" width="14" height="3.5" rx="1.5" />
    </g>
  )}
</svg>

<style>
  .diagram {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .d-frame,
  .d-device,
  .d-bubble,
  .d-card {
    fill: var(--bg);
    stroke: var(--ink);
    stroke-width: 1.5;
  }

  .d-panel {
    fill: var(--surface-strong);
  }

  .d-light {
    fill: var(--accent-tint);
    opacity: 0.9;
  }

  .d-line,
  .d-draw,
  .d-arrow {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .d-line {
    stroke: var(--line-strong);
    stroke-width: 1;
  }

  .d-ink {
    fill: var(--ink);
  }

  .d-soft {
    fill: var(--line-strong);
  }

  .d-field {
    fill: var(--bg);
    stroke: var(--line-strong);
    stroke-width: 1;
  }

  .d-accent,
  .d-dot-accent {
    fill: var(--accent);
  }

  .d-accent-soft {
    fill: var(--accent-tint);
    stroke: var(--accent);
    stroke-width: 1;
  }

  .d-dot {
    fill: var(--ink);
  }

  .d-travel {
    fill: var(--accent);
  }

  /* Desenho ao aparecer (a classe .is-drawn vem do script da seção). */
  .d-draw {
    stroke-dasharray: 120;
    stroke-dashoffset: 0;
  }

  .d-move,
  .d-move-light,
  .d-travel {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.6s var(--ease-out), opacity 0.6s var(--ease-out);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.tiles:not(.is-drawn)) .d-draw {
      stroke-dashoffset: 120;
    }

    :global(.tiles.is-drawn) .d-draw {
      transition: stroke-dashoffset 1.1s var(--ease-out) 0.15s;
    }

    :global(.tile:hover) .d-move,
    :global(.tile:focus-visible) .d-move {
      transform: translateY(-3px) scale(1.04);
    }

    :global(.tile:hover) .d-move-light,
    :global(.tile:focus-visible) .d-move-light {
      transform: translateX(-6px) skewX(-6deg);
      opacity: 1;
    }

    :global(.tile:hover) .d-travel,
    :global(.tile:focus-visible) .d-travel {
      transform: translateX(36px);
      transition-duration: 0.9s;
    }

    :global(.tile:hover) .d-arrow,
    :global(.tile:focus-visible) .d-arrow {
      transform: translateX(3px);
      transition: transform 0.4s var(--ease-out);
    }
  }
</style>
