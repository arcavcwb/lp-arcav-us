---
// Hero da home: o título e as duas ações à esquerda; o retrato de trabalho nas últimas colunas,
// um pouco abaixo do título. No celular, o retrato vem depois das ações, a toda a largura, em 4:3.
import Icon from '../ui/Icon.astro';
import Photo from '../ui/Photo.astro';
import { home } from '../../data/site';
import { ANCHOR, toAnchor } from '../../data/anchors';
import { ui } from '../../data/ui';
import { photoShown } from '../../lib/photos';

const { hero } = home;
const withPhoto = photoShown('work');
---
<section class="page-hero hero-home" aria-labelledby="hero-title">
  <div class:list={['shell grid gap-10', { 'xl:grid-cols-hero-portrait xl:gap-16': withPhoto }]}>
    <div>
      <h1 class="h1 max-w-headline" id="hero-title">{hero.title}</h1>
      <p class="lead">{hero.subtitle}</p>
      <div class="page-hero__actions">
        <a class="btn btn--primary" href={toAnchor(ANCHOR.contact)}>
          {hero.primaryCta}
          <Icon name="arrow-right" />
        </a>
        <a class="btn btn--ghost" href={toAnchor(ANCHOR.solutions)}>{hero.secondaryCta}</a>
      </div>
    </div>

    {withPhoto && (
      <figure class="m-0 grid content-start gap-3 xl:mt-portrait-drop">
        <Photo photo="work" crop="aspect-wide xl:aspect-portrait" eager />
        <figcaption class="text-caption text-muted">{ui.photo.caption}</figcaption>
      </figure>
    )}
  </div>
</section>
