---
// Hero da home: título, subtítulo e ações à esquerda (8 de 12 colunas); o retrato de trabalho à
// direita (4 colunas), centrado na altura do texto. O título fica na escala normal dos heros: a frase
// é longa, e grande demais ela vira um cartaz (feedback de 2026-11-21). No celular, o retrato vem
// depois das ações, a toda a largura, em 4:3. Ao carregar, o texto entra em sequência e o retrato
// se descobre de baixo para cima. A ação principal abre a janela do formulário.
import { Icon, Photo } from '@components/ui';
import { ANCHOR, home, toAnchor, ui } from '@data';
import { photoShown } from '@lib';

const { hero } = home;
const withPhoto = photoShown('work');
---
<section class:list={['page-hero hero', { 'hero--with-photo': withPhoto }]} aria-labelledby="hero-title">
  <div class="shell hero__grid">
    <div class="enter-group">
      <h1 class="h1" id="hero-title">{hero.title}</h1>
      <p class="lead">{hero.subtitle}</p>
      <div class="page-hero__actions">
        <button class="btn btn--primary" type="button" popovertarget={ANCHOR.contactForm}>
          {hero.primaryCta}
          <Icon name="arrow-right" />
        </button>
        <a class="btn btn--ghost" href={toAnchor(ANCHOR.solutions)}>{hero.secondaryCta}</a>
      </div>
    </div>

    {withPhoto && (
      <figure class="enter-image hero__figure">
        <Photo photo="work" class="hero__photo" eager />
        <figcaption class="hero__caption">{ui.photo.caption}</figcaption>
      </figure>
    )}
  </div>
</section>
