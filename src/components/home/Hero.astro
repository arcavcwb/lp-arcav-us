---
// Hero da home: título, subtítulo e ações. A partir de 960px, a arte aprovada (2026-11-22: laptop com
// o logo da ARCAV, três ícones e curvas azul e âmbar) se encosta no canto de cima, à direita, atrás
// do texto. No celular a arte não aparece nem é baixada (2026-11-24): só o `<source>` do desktop tem a
// arte; o `<img>` é uma imagem vazia de 1px. A lista de casos começa já na primeira tela. A arte é decorativa.
// A ação principal abre o WhatsApp da ARCAV com a mensagem pronta (sem número, abre a janela do
// formulário); a secundária leva à demonstração. Embaixo, uma linha com quem atende (e o prazo de
// resposta, quando RESPONSE_TIME existir). `data-wa-bar-hide`: enquanto as ações estão à vista, a
// barra fixa do WhatsApp (WhatsAppBar.astro) fica escondida.
import { ContactAction, Icon } from '@components/ui';
import { ANCHOR, home, toAnchor, ui } from '@data';
import { RESPONSE_TIME } from '@lib';

const { hero } = home;
const { art } = hero;
const note = [RESPONSE_TIME && hero.note.response(RESPONSE_TIME), hero.note.place].filter(Boolean).join(' · ');
/** GIF transparente de 1px: abaixo de `art.desktopMedia`, o navegador fica com ele e não baixa a arte. */
const BLANK = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';
---
<section class="page-hero hero has-orbs" aria-labelledby="hero-title">
  <div class="orbs" aria-hidden="true">
    <span class="orbs__orb orbs__orb--blue"></span>
    <span class="orbs__orb orbs__orb--amber"></span>
  </div>
  <div class="shell hero__grid">
    <div class="enter-group">
      <h1 class="h1" id="hero-title">{hero.title}</h1>
      <p class="lead">{hero.subtitle}</p>
      <div class="page-hero__actions" data-wa-bar-hide>
        <ContactAction label={hero.primaryCta} message={home.contact.waMessage} fallbackLabel={ui.header.cta} />
        <a class="btn btn--ghost" href={toAnchor(ANCHOR.experiment)}>
          {hero.secondaryCta}
          <Icon name="arrow-right" />
        </a>
      </div>
      <p class="small hero-note">{note}</p>
    </div>
  </div>

  <div class="enter-image hero__art" aria-hidden="true">
    <picture>
      <source media={art.desktopMedia} srcset={art.desktop.src} width={art.desktop.width} height={art.desktop.height} />
      <img
        class="hero__art-image"
        src={BLANK}
        width={art.desktop.width}
        height={art.desktop.height}
        alt=""
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
  </div>
</section>
