---
// "Qual é o seu caso?" (2026-11-24): os cinco serviços com o mesmo peso, numa lista com filetes em vez
// de cartões. Cada linha inteira é o link para a página do serviço: o ícone, a frase do cliente (o que
// a pessoa reconhece) e, embaixo, o nome do serviço. No celular, uma coluna logo depois do hero; a
// partir de 960px, o título à esquerda e a lista à direita. A demonstração vem na seção seguinte.
import { Icon } from '@components/ui';
import { ANCHOR, SERVICES, home } from '@data';
import { quoted, solutionTransition } from '@lib';

const { services } = home;
---
<section class="section services" id={ANCHOR.solutions} aria-labelledby="solucoes-title">
  <div class="shell services__layout">
    <div class="services__head">
      <h2 class="h2 h2--feature" id="solucoes-title">{services.title}</h2>
      <p class="lead">{services.subtitle}</p>
    </div>

    <ul role="list" class="cases">
      {SERVICES.map((s) => (
        <li>
          <a class="case" href={s.path}>
            <span class="icon-badge case__icon" aria-hidden="true"><Icon name={s.icon} /></span>
            <span class="case__text">
              <span class="case__quote">{quoted(s.situation!)}</span>
              <span class="case__name" style={solutionTransition(s.slug)}>{s.name}</span>
            </span>
            <Icon name="arrow-right" class="case__arrow" />
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
