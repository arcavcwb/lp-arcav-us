---
// Sobre: retrato próximo à esquerda e texto à direita. Sem foto e sem marcador, o texto ocupa a linha.
import { Icon, Photo } from '@components/ui';
import { ANCHOR, BRAND, home, ui } from '@data';
import { EXTERNAL_LINK, photoShown } from '@lib';

const { about } = home;
const hasPhoto = photoShown('portrait');
---
<section class:list={['section section--muted about', { 'about--with-photo': hasPhoto }]} id={ANCHOR.about} aria-labelledby="sobre-title">
  <div class="shell about__grid">
    {hasPhoto && <Photo photo="portrait" class="about__photo" />}

    <div class="about__content">
      <h2 class="h2" id="sobre-title">{about.title}</h2>
      <p class="lead about__lead">{about.text}</p>

      <dl class="about__facts">
        <div>
          <dt class="about__term">{ui.labels.trajectory}</dt>
          <dd class="about__value">
            <ol role="list" class="flow about__trajectory">
              {BRAND.trajectory.map((place) => <li>{place}</li>)}
            </ol>
          </dd>
        </div>
        <div>
          <dt class="about__term">{about.base}</dt>
          <dd class="about__value">{BRAND.location}</dd>
        </div>
      </dl>

      <p class="about__statement">{about.statement}</p>

      <ul role="list" class="about__social">
        {BRAND.social.map((item) => (
          <li>
            <a class="link-arrow" href={item.href} {...EXTERNAL_LINK}>
              {item.name}
              <Icon name="external" />
              <span class="visually-hidden">{ui.a11y.newTab}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
