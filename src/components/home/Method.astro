---
// Método: os seis passos, do problema ao produto, em cartões de vidro lado a lado (pedido do
// usuário, 2026-11-22), com acabamento de produto: ícone num poço, contador "01 / 06", título,
// texto e uma barra com o avanço no processo (ProcessCards, o mesmo de "Como funciona" das
// soluções). As duas luzes da marca (.orbs) ficam atrás dos cartões para o vidro ter o que
// desfocar. Até 1200px a fila desliza de lado; a partir daí, os seis cabem na largura. Só a entrada
// se mexe, uma vez; com "reduzir movimento", nada se mexe; sem JavaScript, tudo aparece igual.
import { ProcessCards } from '@components/ui';
import { ANCHOR, home } from '@data';

const { method } = home;
---
<section class="section method has-orbs" id={ANCHOR.method} aria-labelledby="metodo-title">
  <div class="orbs" aria-hidden="true">
    <span class="orbs__orb orbs__orb--blue"></span>
    <span class="orbs__orb orbs__orb--amber"></span>
  </div>

  <div class="shell">
    <h2 class="h2 h2--feature method__title" id="metodo-title">{method.title}</h2>
    <ProcessCards steps={method.steps} labelledby="metodo-title" />
  </div>
</section>
