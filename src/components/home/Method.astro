---
import { home } from '../../data/site';
import { ANCHOR } from '../../data/anchors';

const { method } = home;
---
<section class="section" id={ANCHOR.method} aria-labelledby="metodo-title">
  <div class="shell">
    <div class="section-head">
      <h2 class="h2" id="metodo-title">{method.title}</h2>
    </div>

    <ol class="steps steps--3">
      {method.steps.map((step) => (
        <li>
          <strong>{step.title}</strong>
          <p>{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
