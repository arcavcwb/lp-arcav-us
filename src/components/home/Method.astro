---
// "Como funciona" (2026-11-24; substitui o método de seis cartões em carrossel): os mesmos quatro
// passos das páginas de solução (SOLUTION_STEPS), em lista numerada com filetes, e quem atende, com o
// link para o LinkedIn (e a foto do Armando, quando ela existir em src/assets/fotos/). No celular, um
// embaixo do outro; a partir de 960px, quem atende à esquerda e os passos à direita.
import { Icon } from '@components/ui';
import { ANCHOR, BRAND, PHOTOS, SOLUTION_STEPS, home, ui } from '@data';
import { EXTERNAL_LINK, photoFor } from '@lib';

const { how } = home;
const photo = photoFor('portrait');
const linkedin = BRAND.social.find((s) => s.name === 'LinkedIn');
---
<section class="section how" id={ANCHOR.method} aria-labelledby="como-title">
  <div class="shell how__layout">
    <div class="how__head">
      <h2 class="h2 h2--feature" id="como-title">{how.title}</h2>
      {photo && (
        <img class="how__photo" src={photo.src} width={photo.width} height={photo.height} alt={PHOTOS.portrait.alt} loading="lazy" decoding="async" />
      )}
      <p class="lead">{how.about}</p>
      {linkedin && (
        <a class="link-arrow how__link" href={linkedin.href} {...EXTERNAL_LINK}>
          {how.linkedin}
          <Icon name="external" />
          <span class="visually-hidden">{ui.a11y.newTab}</span>
        </a>
      )}
    </div>

    <ol class="steps steps--text how__steps">
      {SOLUTION_STEPS.map((step) => <li><p>{step}</p></li>)}
    </ol>
  </div>
</section>
