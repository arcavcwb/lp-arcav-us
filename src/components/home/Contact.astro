---
// Contato da home: o mesmo fechamento em azul profundo das outras páginas, com a lista de canais e o título
// maior. O formulário abre numa janela.
import { ClosingContact } from '@components/ui';
import { home } from '@data';

const { contact } = home;
---
<ClosingContact
  title={contact.title}
  text={contact.subtitle}
  subject={contact.subject}
  waMessage={contact.waMessage}
  channels
  feature
/>
