---
import ContactForm from '../ui/ContactForm.astro';
import Icon from '../ui/Icon.astro';
import { BRAND, home } from '../../data/site';
import { ARCAV_WHATSAPP_DISPLAY, whatsappLink } from '../../lib/contact';

const wa = whatsappLink('Olá, Armando! Vi o site da ARCAV e quero conversar sobre o meu negócio.');

const { contact } = home;
---
<section class="section" id="contato" aria-labelledby="contato-title">
  <div class="container contact">
    <div class="contact__copy">
      <h2 class="h2" id="contato-title">{contact.title}</h2>
      <p class="lead">{contact.subtitle}</p>

      <ul role="list" class="contact__direct">
        {wa && (
          <li>
            <Icon name="chat" />
            <a href={wa} target="_blank" rel="noopener noreferrer">WhatsApp {ARCAV_WHATSAPP_DISPLAY}</a>
          </li>
        )}
        <li>
          <Icon name="mail" />
          <a href={`mailto:${BRAND.email}`}>{BRAND.email}</a>
        </li>
        <li>
          <Icon name="pin" />
          <span>{BRAND.location}</span>
        </li>
      </ul>
    </div>

    <div class="card contact__form">
      <ContactForm subject={contact.subject} />
    </div>
  </div>
</section>

<style>
  .contact {
    display: grid;
    gap: clamp(2.5rem, 1.5rem + 3vw, 4rem);
    align-items: start;
  }

  .contact__copy .lead {
    margin-top: 1rem;
  }

  .contact__direct {
    display: grid;
    gap: 0.875rem;
    margin-top: 2rem;
  }

  .contact__direct li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 500;
  }

  .contact__direct :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--muted);
    flex: none;
  }

  .contact__form {
    box-shadow: var(--shadow-raised);
    border-color: transparent;
  }

  @media (min-width: 900px) {
    .contact {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    }

    .contact__copy {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }
  }
</style>
