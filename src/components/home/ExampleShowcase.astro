---
// Mostruário da home: só exemplos que funcionam (example.path definido). As soluções sem exemplo ficam
// fora até ganharem um, sem mudar esta estrutura. Com um só exemplo, as abas não aparecem.
import ExampleFrame from '../ui/ExampleFrame.astro';
import Icon from '../ui/Icon.astro';
import { SOLUTIONS } from '../../data/solutions';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const items = SOLUTIONS.filter((s) => s.example.path);
const tabbed = items.length > 1;

const TAB_LABEL: Record<string, string> = {
  'landing-page-alto-padrao': 'Alto padrão',
  'landing-page-campanhas': 'Campanhas',
  'landing-page-produto': 'Produto',
  'landing-page-palestras': 'Palestras',
  'comercio-digital': 'Comércio',
  'sistemas-e-automacao': 'Automação',
};
---
<div class:list={['showcase', className]} data-showcase>
  {tabbed && (
  <div class="showcase__tabs" role="tablist" aria-label="Exemplos por solução">
    {items.map((s, i) => (
      <button
        type="button"
        role="tab"
        id={`tab-${s.slug}`}
        aria-controls={`panel-${s.slug}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
        data-tab
      >
        {TAB_LABEL[s.slug] ?? s.name}
      </button>
    ))}
  </div>
  )}

  {items.map((s, i) => (
    <div
      class="showcase__panel"
      role={tabbed ? 'tabpanel' : undefined}
      id={`panel-${s.slug}`}
      aria-labelledby={tabbed ? `tab-${s.slug}` : undefined}
      hidden={i !== 0}
      data-panel
    >
      <ExampleFrame href={s.example.path} image={s.example.image} client={s.example.client} eager={i === 0} />
      <div class="showcase__info">
        <h3 class="h3">{s.name}</h3>
        <p>{s.short}</p>
        <div class="showcase__links">
          {s.example.path && <a class="btn btn--ghost btn--sm" href={s.example.path}>Abrir o exemplo</a>}
          <a class="link-arrow" href={s.path}>
            Ver a solução
            <Icon name="arrow-right" />
          </a>
        </div>
      </div>
    </div>
  ))}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-showcase]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];

    const select = (index: number, focus = false) => {
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        panels[i].hidden = !on;
      });
      if (focus) tabs[index].focus();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (event) => {
        const keys: Record<string, number> = {
          ArrowRight: (i + 1) % tabs.length,
          ArrowLeft: (i - 1 + tabs.length) % tabs.length,
          Home: 0,
          End: tabs.length - 1,
        };
        if (event.key in keys) {
          event.preventDefault();
          select(keys[event.key], true);
        }
      });
    });
  });
</script>

<style>
  .showcase {
    display: grid;
    gap: 1rem;
  }

  .showcase__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .showcase__tabs button {
    min-height: 2.75rem;
    padding: 0 0.875rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: var(--bg);
    color: var(--muted);
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      color 0.15s ease,
      border-color 0.15s ease;
  }

  .showcase__tabs button:hover {
    border-color: var(--ink);
    color: var(--ink);
  }

  .showcase__tabs button[aria-selected='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--on-dark);
  }

  .showcase__panel {
    display: grid;
    gap: 1.5rem;
    align-items: center;
    animation: panel-in 0.35s var(--ease-out);
  }

  .showcase__info {
    display: grid;
    gap: 0.75rem;
    max-width: 26rem;
  }

  .showcase__info p {
    color: var(--muted);
  }

  .showcase__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-top: 0.5rem;
  }

  @media (min-width: 960px) {
    .showcase__panel {
      grid-template-columns: minmax(0, 1.75fr) minmax(0, 1fr);
      gap: 3rem;
    }
  }

  .showcase__panel[hidden] {
    display: none;
  }


  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
  }
</style>
