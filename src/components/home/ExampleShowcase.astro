---
// Mostruário da home: só exemplos que funcionam (example.path definido). Hoje há um; o portfólio
// editorial (fase C) substitui esta lista quando houver três ou mais projetos externos.
import { ExampleFrame, Icon } from '@components/ui';
import { SOLUTIONS, ui } from '@data';

const items = SOLUTIONS.filter((s) => s.example.path);
---
<div class="showcase" data-showcase>
  {items.map((s, i) => (
    <div class="showcase__item" id={`panel-${s.slug}`} data-panel>
      <ExampleFrame href={s.example.path} image={s.example.image} client={s.example.client} eager={i === 0} />
      <div class="showcase__copy">
        <h3 class="h3">{s.name}</h3>
        <p class="showcase__text">{s.short}</p>
        <div class="showcase__actions">
          {s.example.path && <a class="btn btn--ghost btn--sm" href={s.example.path}>{ui.examples.open}</a>}
          <a class="link-arrow" href={s.path}>
            {ui.examples.solution}
            <Icon name="arrow-right" />
          </a>
        </div>
      </div>
    </div>
  ))}
</div>
