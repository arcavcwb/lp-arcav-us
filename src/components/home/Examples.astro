---
// Exemplo ("o produto em cena", 2026-11-22): a seção inteira é um escenário (.stage). À esquerda, o
// texto e o link para a solução; à direita, a loja de exemplo de verdade (PhoneDemo, com o guia
// "Experimente"), para o visitante montar um pedido aqui mesmo, e três peças com os ícones dos
// passos do guia (escolher, revisar, enviar). O JavaScript da demo só carrega quando ela chega perto
// da tela (PhoneDemo); sem ele, o celular mostra o pedido inicial. A legenda diz que a loja é um
// exemplo e não um cliente real.
import { Icon, IconTile, PhoneDemo } from '@components/ui';
import { ANCHOR, commerceService, home, solutionPath, ui } from '@data';

const { examples } = home;
const { demo } = commerceService;
---
<section class="section section--dark stage examples" id={ANCHOR.examples} aria-labelledby="exemplos-title">
  <div class="shell examples__grid">
    <div class="examples__copy">
      <h2 class="h2" id="exemplos-title">{examples.title}</h2>
      <p class="lead">{examples.lead}</p>
      <a class="link-arrow" href={solutionPath('comercio-digital')}>
        {ui.examples.solution}
        <Icon name="arrow-right" />
      </a>
    </div>

    <div class="examples__scene">
      <div class="examples__device">
        <PhoneDemo products={demo.products} caption={demo.caption} next={demo.next} guide />
        <IconTile icon="cart" step={1} class="examples__tile examples__tile--1" />
        <IconTile icon="form" step={2} class="examples__tile examples__tile--2" />
        <IconTile icon="send" step={3} class="examples__tile examples__tile--3" />
      </div>
    </div>
  </div>
</section>
