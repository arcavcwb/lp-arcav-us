---
import ExampleShowcase from './ExampleShowcase.astro';
import { ANCHOR, home } from '@data';

const { examples } = home;
---
<section class="section section--muted has-orbs" id={ANCHOR.examples} aria-labelledby="exemplos-title">
  <div class="orbs" aria-hidden="true">
    <span class="orbs__orb orbs__orb--blue"></span>
    <span class="orbs__orb orbs__orb--amber"></span>
  </div>
  <div class="shell">
    <div class="section-head section-head--split">
      <h2 class="h2" id="exemplos-title">{examples.title}</h2>
      <p class="lead lead--md">{examples.lead}</p>
    </div>
    <ExampleShowcase />
  </div>
</section>
