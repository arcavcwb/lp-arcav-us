---
import ExampleShowcase from './ExampleShowcase.astro';
import { home } from '../../data/site';
import { ANCHOR } from '../../data/anchors';

const { examples } = home;
---
<section class="section" id={ANCHOR.examples} aria-labelledby="exemplos-title">
  <div class="shell">
    <div class="section-head">
      <h2 class="h2" id="exemplos-title">{examples.title}</h2>
      <p class="lead">{examples.lead}</p>
    </div>
    <ExampleShowcase />
  </div>
</section>
