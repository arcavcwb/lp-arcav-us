---
// Manifesto: a seção inteira em azul profundo, um respiro no meio da página. A citação é a protagonista
// e se revela da esquerda para a direita ao chegar à tela; o título e o texto ficam acima, menores;
// o antes e o depois em duas colunas com fios, sem caixas.
import { Icon } from '@components/ui';
import { BRAND, home } from '@data';
import { quoted } from '@lib';

const { problem } = home;
---
<section class="section section--dark manifesto" aria-labelledby="problema-title">
  <div class="shell manifesto__shell">
    <div class="manifesto__head">
      <h2 class="manifesto__title" id="problema-title">{problem.title}</h2>
      <p class="manifesto__text">{problem.text}</p>
    </div>

    <figure class="manifesto__figure">
      <blockquote class="manifesto__quote reveal-wipe">
        <p>{quoted(problem.quote)}</p>
      </blockquote>
      <figcaption class="manifesto__author">{BRAND.author}</figcaption>
    </figure>

    <div class="manifesto__compare">
      <div>
        <h3 class="manifesto__label">{problem.before.label}</h3>
        <ul role="list" class="manifesto__list">
          {problem.before.items.map((item) => (
            <li class="manifesto__row"><Icon name="minus" class="manifesto__mark" />{item}</li>
          ))}
        </ul>
      </div>
      <div>
        <h3 class="manifesto__label manifesto__label--after">{problem.after.label}</h3>
        <ul role="list" class="manifesto__list">
          {problem.after.items.map((item) => (
            <li class="manifesto__row manifesto__row--after"><Icon name="check" class="manifesto__mark manifesto__mark--after" />{item}</li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
