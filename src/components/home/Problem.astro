---
import Icon from '../ui/Icon.astro';
import { BRAND, home } from '../../data/site';
import { quoted } from '../../lib/text';

const { problem } = home;

/** Linha da comparação Hoje / Depois e o seu ícone. */
const row = 'flex items-start gap-3 text-h3 leading-body font-semibold tracking-tight';
const mark = 'mt-optical size-5 flex-none';
---
<section class="section section--muted" aria-labelledby="problema-title">
  <div class="shell grid items-center gap-split split:grid-cols-lead">
    <div>
      <h2 class="h2" id="problema-title">{problem.title}</h2>
      <p class="lead mt-4">{problem.text}</p>
      <figure class="mt-8">
        <blockquote class="max-w-lg text-lg leading-normal font-medium">
          <p>{quoted(problem.quote)}</p>
        </blockquote>
        <figcaption class="mt-2 text-sm text-muted">{BRAND.author}</figcaption>
      </figure>
    </div>

    <div class="grid gap-4 pair:max-split:grid-cols-2">
      <div class="rounded-card border border-line bg-paper px-7 py-6">
        <h3 class="mb-4 text-sm font-semibold text-muted">{problem.before.label}</h3>
        <ul role="list" class="grid gap-3">
          {problem.before.items.map((item) => (
            <li class={`${row} text-muted`}><Icon name="minus" class={mark} />{item}</li>
          ))}
        </ul>
      </div>
      <div class="rounded-card border border-dark bg-dark px-7 py-6 text-on-dark">
        <h3 class="mb-4 text-sm font-semibold text-on-dark-muted">{problem.after.label}</h3>
        <ul role="list" class="grid gap-3">
          {problem.after.items.map((item) => (
            <li class={row}><Icon name="check" class={`${mark} text-clay`} />{item}</li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
