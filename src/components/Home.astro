---
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Lines from './Lines.astro';
import Work from './Work.astro';
import Start from './Start.astro';
import About from './About.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import { translations, type Lang } from '../i18n/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang];
---
<Layout title={t.meta.title} description={t.meta.description} lang={lang} skip={t.skip}>
  <Header lang={lang} nav={t.nav} />
  <main id="contenido">
    <Hero hero={t.hero} lineNames={t.lineNames} />
    <Lines lines={t.lines} />
    <Work work={t.work} lineNames={t.lineNames} />
    <Start start={t.start} />
    <About about={t.about} />
    <Contact contact={t.contact} lang={lang} />
  </main>
  <Footer footer={t.footer} lineNames={t.lineNames} lang={lang} languageLabel={t.nav.language} />
</Layout>
