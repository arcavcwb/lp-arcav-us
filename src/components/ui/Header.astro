---
// Cabeçalho fixo. Abaixo de 900px a navegação vira um painel (popover): o botão abre e fecha,
// Esc e um toque fora também fecham, sem JavaScript. Um script de três linhas só fecha o painel
// depois de escolher um link. Com `waMessage` e o número da ARCAV, a CTA é "Chamar no WhatsApp" (nova
// aba, com o logo do WhatsApp); abaixo de 420px o rótulo encurta para "WhatsApp" (o nome acessível
// continua completo). Sem número, vale `cta`: abre a janela do formulário (popover) ou é um link comum.
import Brand from './Brand.astro';
import BrandIcon from './BrandIcon.astro';
import Icon from './Icon.astro';
import { HOME_PATH, ui, type NavLink } from '@data';
import { EXTERNAL_LINK, whatsappLink } from '@lib';

interface Props {
  links?: NavLink[];
  /** `popover`: id da janela que o botão abre; sem ele, `href` vira um link comum. */
  cta?: { label: string; href?: string; popover?: string };
  /** Mensagem pronta do WhatsApp: com o número da ARCAV, a CTA vira o link do WhatsApp. */
  waMessage?: string;
}

const { links = [], cta, waMessage } = Astro.props;
const wa = waMessage ? whatsappLink(waMessage) : null;
const hasNav = links.length > 0;
const NAV_ID = 'site-nav';
---
<header class="site-header" data-site-header>
  <div class="shell site-header__bar">
    <a class="site-header__home" href={HOME_PATH} aria-label={ui.a11y.homeLink}>
      <Brand compact />
    </a>

    {hasNav && (
      <nav class="site-nav" id={NAV_ID} aria-label={ui.header.nav} popover data-site-nav>
        <ul role="list" class="site-nav__list">
          {links.map((link) => (
            <li class="site-nav__item">
              <a class="site-nav__link" href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <div class:list={['site-header__actions', { 'site-header__actions--after-nav': hasNav }]}>
      {wa ? (
        <a class="btn btn--primary btn--sm site-header__cta" href={wa} {...EXTERNAL_LINK} aria-label={ui.whatsappCta}>
          <BrandIcon name="whatsapp" mono />
          <span class="site-header__cta-full">{ui.whatsappCta}</span>
          <span class="site-header__cta-short" aria-hidden="true">{ui.labels.whatsapp}</span>
        </a>
      ) : cta && (cta.popover ? (
        <button class="btn btn--primary btn--sm" type="button" popovertarget={cta.popover}>{cta.label}</button>
      ) : (
        <a class="btn btn--primary btn--sm" href={cta.href}>{cta.label}</a>
      ))}
      {hasNav && (
        <button class="site-header__toggle" type="button" popovertarget={NAV_ID} data-menu-toggle>
          <span class="visually-hidden">{ui.header.menu}</span>
          <Icon name="menu" class="site-header__icon site-header__icon--open" />
          <Icon name="close" class="site-header__icon site-header__icon--close" />
        </button>
      )}
    </div>
  </div>
</header>

<script>
  import { initSiteMenu } from '@scripts/site-menu';

  initSiteMenu();
</script>
