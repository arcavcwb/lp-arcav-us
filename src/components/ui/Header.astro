---
import Brand from './Brand.astro';
import Icon from './Icon.astro';
import { HOME_PATH } from '../../data/anchors';
import type { NavLink } from '../../data/navigation';
import { ui } from '../../data/ui';

interface Props {
  links?: NavLink[];
  cta?: { href: string; label: string };
}

const { links = [], cta } = Astro.props;
const hasNav = links.length > 0;

/** Abaixo do ponto `split` (900px) a navegação vira um menu sanfona sob o cabeçalho. */
const navMobile =
  'max-split:absolute max-split:inset-x-0 max-split:top-full max-split:m-0 max-split:hidden max-split:border-b max-split:border-line max-split:bg-paper max-split:px-gutter max-split:pt-2 max-split:pb-5 max-split:shadow-drawer max-split:data-open:block';
const navLink =
  'block rounded-control px-3 py-2 text-sm font-medium text-muted no-underline transition-colors hover:bg-surface hover:text-ink max-split:rounded-none max-split:px-1 max-split:py-3.5 max-split:text-base max-split:text-ink';
---
<header
  class="site-header sticky top-0 z-header border-b border-transparent bg-paper transition-colors duration-quick data-scrolled:border-line"
  data-site-header
>
  <div class="shell flex min-h-header items-center gap-6">
    <a class="rounded-xs text-ink no-underline" href={HOME_PATH} aria-label={ui.a11y.homeLink}>
      <Brand compact />
    </a>

    {hasNav && (
      <nav class:list={['ml-auto', navMobile]} id="site-nav" aria-label={ui.header.nav} data-site-nav>
        <ul role="list" class="flex gap-1 max-split:flex-col max-split:gap-0">
          {links.map((link) => (
            <li class="max-split:border-b max-split:border-line max-split:last:border-b-0">
              <a class={navLink} href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <div class:list={['flex items-center gap-3', hasNav ? 'ml-2 max-split:ml-auto' : 'ml-auto']}>
      {cta && <a class="btn btn--primary btn--sm" href={cta.href}>{cta.label}</a>}
      {hasNav && (
        <button
          class="group hidden size-11 cursor-pointer place-items-center rounded-control border border-line-strong bg-paper p-0 max-split:grid"
          type="button"
          aria-expanded="false"
          aria-controls="site-nav"
          data-menu-toggle
        >
          <span class="visually-hidden" data-menu-label>{ui.header.menuOpen}</span>
          <Icon name="menu" class="size-5.5 group-aria-expanded:hidden" />
          <Icon name="close" class="hidden size-5.5 group-aria-expanded:block" />
        </button>
      )}
    </div>
  </div>
</header>

<script>
  import { initSiteHeader } from '../../scripts/site-header';

  initSiteHeader();
</script>
