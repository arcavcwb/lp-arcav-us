---
import { portraitUrl as photo } from '../../lib/brand-assets';
// Retrato de Armando Castro. Coloque a foto em src/assets/brand/armando.(jpg|jpeg|png|webp)
// e ela aparece aqui no próximo build. Sem a foto, mostra as iniciais (não é uma foto falsa).
interface Props {
  size?: 'avatar' | 'portrait';
  class?: string;
}

const { size = 'portrait', class: className } = Astro.props;

---
<span class:list={['portrait', `portrait--${size}`, className]}>
  {photo ? (
    <img src={photo} alt="Armando Castro" loading={size === 'portrait' ? 'lazy' : 'eager'} decoding="async" />
  ) : (
    <span class="portrait__initials" role="img" aria-label="Armando Castro">AC</span>
  )}
</span>

<style>
  .portrait {
    display: block;
    overflow: hidden;
    background: var(--surface-strong);
    color: var(--muted);
  }

  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .portrait__initials {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--ink);
  }

  .portrait--avatar {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    flex: none;
  }

  .portrait--avatar .portrait__initials {
    font-size: 0.9375rem;
  }

  .portrait--portrait {
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-card);
  }

</style>
