---
// Avatar redondo de quem responde: o retrato de data/photos.ts quando existir; até lá, o símbolo da
// ARCAV (pedido do usuário, 2026-11-22: o logo no lugar das iniciais "AC"; não é uma foto falsa).
import Logo from './Logo.astro';
import { PHOTOS } from '@data';
import { photoFor } from '@lib';

const photo = photoFor('portrait');
---
<span class="avatar">
  {photo ? (
    <img class="avatar__image" src={photo.src} width={photo.width} height={photo.height} alt={PHOTOS.portrait.alt} decoding="async" />
  ) : (
    <span class="avatar__symbol"><Logo symbol /></span>
  )}
</span>
