---
// Pontos de uma oferta em lista com fios (mesma família de "Para quem é / O que está incluído"):
// título e texto lado a lado no desktop, empilhados no celular. Substitui a grade de cartões com
// ícone em caixa sobre o título, que lia como modelo genérico.
interface Props {
  items: Array<{ title: string; text: string }>;
  class?: string;
}

const { items, class: className } = Astro.props;
---
<ul role="list" class:list={['ruled', className]}>
  {items.map((item) => (
    <li>
      <h3>{item.title}</h3>
      <p>{item.text}</p>
    </li>
  ))}
</ul>

<style>
  .ruled {
    display: grid;
    border-top: 1px solid var(--ink);
  }

  .ruled li {
    display: grid;
    gap: 0.375rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--line);
  }

  .ruled h3 {
    font-size: 1.125rem;
    font-weight: 650;
    line-height: 1.35;
    text-wrap: balance;
  }

  .ruled p {
    max-width: 60ch;
    color: var(--muted);
  }

  @media (min-width: 720px) {
    .ruled li {
      grid-template-columns: minmax(0, 17rem) minmax(0, 1fr);
      gap: 2.5rem;
      padding: 1.5rem 0;
    }
  }
</style>
