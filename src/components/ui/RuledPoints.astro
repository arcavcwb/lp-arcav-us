---
// Pontos de uma oferta em lista com fios (mesma família de "Para quem é / O que está incluído"):
// título e texto lado a lado no desktop, empilhados no celular.
interface Props {
  items: Array<{ title: string; text: string }>;
}

const { items } = Astro.props;
---
<ul role="list" class="ruled-points">
  {items.map((item) => (
    <li class="ruled-points__item">
      <h3 class="ruled-points__title">{item.title}</h3>
      <p class="ruled-points__text">{item.text}</p>
    </li>
  ))}
</ul>
