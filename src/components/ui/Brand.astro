---
// Marca ARCAV: o logo (Logo.astro) e, ao lado, "por Armando Castro" em texto.
import Logo from './Logo.astro';
import { ui } from '@data';

interface Props {
  /** Mostra "por Armando Castro" ao lado da marca. */
  byline?: boolean;
  tone?: 'light' | 'dark';
  /** Cabeçalho: só o símbolo abaixo de 420px e sem "por Armando Castro" abaixo de 640px. */
  compact?: boolean;
}

const { byline = true, tone = 'light', compact = false } = Astro.props;
---
<span class:list={['brand', { 'brand--dark': tone === 'dark', 'brand--compact': compact }]}>
  <Logo compact={compact} />
  {byline && <span class="brand__byline">{ui.brand.byline}</span>}
</span>
