---
import { BRAND } from '../../data/site';
import { ui } from '../../data/ui';
import { LOGO_HEIGHT, logoUrl as logo } from '../../lib/brand-assets';
// Marca ARCAV. Se existir um arquivo em src/assets/brand/arcav-logo.(svg|png|webp),
// ele substitui o wordmark de texto automaticamente no próximo build.
interface Props {
  /** Mostra "por Armando Castro" ao lado da marca. */
  byline?: boolean;
  tone?: 'light' | 'dark';
  /** Esconde "por Armando Castro" abaixo do ponto `sm` (cabeçalho no celular). */
  compact?: boolean;
}

const { byline = true, tone = 'light', compact = false } = Astro.props;
---
<span class="inline-flex items-baseline gap-2.5 whitespace-nowrap">
  {logo ? (
    <img class="h-7 w-auto self-center" src={logo} alt={BRAND.name} height={LOGO_HEIGHT} />
  ) : (
    <span class="text-brand leading-none font-extrabold tracking-brand">{BRAND.name}</span>
  )}
  {byline && (
    <span class:list={['text-meta font-medium', tone === 'dark' ? 'text-on-dark-muted' : 'text-muted', { 'max-sm:hidden': compact }]}>
      {ui.brand.byline}
    </span>
  )}
</span>
