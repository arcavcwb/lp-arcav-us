---
import Brand from './Brand.astro';
import Icon from './Icon.astro';
import { BRAND, home } from '../../data/site';
import { HOME_PATH } from '../../data/anchors';
import type { NavLink } from '../../data/navigation';
import { ui } from '../../data/ui';
import { ARCAV_WHATSAPP_DISPLAY, whatsappLink } from '../../lib/contact';

const wa = whatsappLink();

interface Props {
  links?: NavLink[];
  /** Aviso curto acima do rodapé legal (ex.: proposta independente). */
  disclaimer?: string;
}

const { links = [], disclaimer } = Astro.props;

/** Links do rodapé: claros sobre o grafite, sublinhado só no hover. */
const link = 'text-on-dark no-underline hover:underline';
/** Rótulos dos dados (Localização, Trajetória, Contato). */
const term = 'mb-1 text-caption font-semibold text-on-dark-muted';
---
<footer class="site-footer bg-dark pt-footer pb-5 text-on-dark">
  <div class="shell">
    <div class="grid gap-7 columns:grid-cols-footer columns:gap-10">
      <div>
        <a class={link} href={HOME_PATH} aria-label={ui.a11y.homeLink}><Brand tone="dark" /></a>
        <p class="mt-2 max-w-xs text-on-dark-muted">{BRAND.statement}</p>
      </div>

      {links.length > 0 && (
        <nav aria-label={ui.footer.nav}>
          <ul role="list" class="grid grid-cols-2 content-start gap-x-6 gap-y-1.5 text-sm">
            {links.map((item) => (
              <li><a class={link} href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
      )}

      <dl class="grid content-start gap-3 text-sm">
        <div>
          <dt class={term}>{ui.labels.location}</dt>
          <dd>{BRAND.location}</dd>
        </div>
        <div>
          <dt class={term}>{ui.labels.trajectory}</dt>
          <dd>
            <ol role="list" class="flow text-sm text-on-dark" aria-label={ui.labels.trajectoryList}>
              {BRAND.trajectory.map((place) => <li>{place}</li>)}
            </ol>
          </dd>
        </div>
        <div>
          <dt class={term}>{ui.labels.contact}</dt>
          <dd class="grid gap-1">
            {wa && <a class={link} href={wa} target="_blank" rel="noopener noreferrer">{ui.whatsapp(ARCAV_WHATSAPP_DISPLAY)}</a>}
            <a class={link} href={`mailto:${BRAND.email}`}>{BRAND.email}</a>
          </dd>
        </div>
      </dl>
    </div>

    {disclaimer && <p class="mt-6 max-w-2xl border-t border-on-dark-line pt-4 text-sm text-on-dark-muted">{disclaimer}</p>}

    <div class="mt-6 flex flex-wrap items-center justify-between gap-3 border-t border-on-dark-line pt-4 text-sm text-on-dark-muted">
      <p>{home.footer.copyright}</p>
      <ul role="list" class="flex gap-6">
        {BRAND.social.map((item) => (
          <li>
            <a class:list={[link, 'inline-flex items-center gap-1.5']} href={item.href} target="_blank" rel="noopener noreferrer">
              {item.name}
              <Icon name="external" class="size-3.5 opacity-dim" />
              <span class="visually-hidden">{ui.a11y.newTab}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>
