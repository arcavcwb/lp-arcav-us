---
// Rodapé numa faixa só (pedido do usuário, 2026-11-22: mais simples e mais baixo): a marca, os
// links numa linha e o contato; embaixo, os direitos e as redes.
import Brand from './Brand.astro';
import Icon from './Icon.astro';
import { BRAND, HOME_PATH, home, ui, type NavLink } from '@data';
import { EXTERNAL_LINK, ARCAV_WHATSAPP_DISPLAY, whatsappLink } from '@lib';

const wa = whatsappLink();

interface Props {
  links?: NavLink[];
}

const { links = [] } = Astro.props;
---
<footer class="site-footer" data-wa-bar-hide>
  <div class="shell">
    <div class="site-footer__top">
      <a class="site-footer__link" href={HOME_PATH} aria-label={ui.a11y.homeLink}><Brand tone="dark" /></a>

      {links.length > 0 && (
        <nav class="site-footer__nav" aria-label={ui.footer.nav}>
          <ul role="list" class="site-footer__links">
            {links.map((item) => (
              <li><a class="site-footer__link" href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
      )}

      <p class="site-footer__contacts">
        {wa && (
          <a class="site-footer__link" href={wa} {...EXTERNAL_LINK}>
            {ui.labels.whatsapp}{' '}
            <span class="site-footer__phone">{ARCAV_WHATSAPP_DISPLAY}</span>
          </a>
        )}
        <a class="site-footer__link" href={`mailto:${BRAND.email}`}>{BRAND.email}</a>
      </p>
    </div>

    <div class="site-footer__bottom">
      <p>{home.footer.copyright}</p>
      <ul role="list" class="site-footer__social">
        {BRAND.social.map((item) => (
          <li>
            <a class="site-footer__link site-footer__link--icon" href={item.href} {...EXTERNAL_LINK}>
              {item.name}
              <Icon name="external" class="site-footer__external" />
              <span class="visually-hidden">{ui.a11y.newTab}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>
