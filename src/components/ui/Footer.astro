---
import Brand from './Brand.astro';
import Icon from './Icon.astro';
import { BRAND, home, type NavLink } from '../../data/site';
import { ARCAV_WHATSAPP_DISPLAY, whatsappLink } from '../../lib/contact';

const wa = whatsappLink();

interface Props {
  links?: NavLink[];
  /** Aviso curto acima do rodapé legal (ex.: proposta independente). */
  disclaimer?: string;
}

const { links = [], disclaimer } = Astro.props;
---
<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <a href="/" aria-label="ARCAV, página inicial"><Brand tone="dark" /></a>
        <p>{BRAND.statement}</p>
      </div>

      {links.length > 0 && (
        <nav aria-label="Rodapé">
          <ul role="list" class="site-footer__links">
            {links.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </nav>
      )}

      <dl class="site-footer__facts">
        <div>
          <dt>Localização</dt>
          <dd>{BRAND.location}</dd>
        </div>
        <div>
          <dt>Trajetória</dt>
          <dd>
            <ol role="list" class="flow flow--dark" aria-label="Trajetória profissional">
              {BRAND.trajectory.map((place) => <li>{place}</li>)}
            </ol>
          </dd>
        </div>
        <div>
          <dt>Contato</dt>
          <dd class="site-footer__contact">
            {wa && <a href={wa} target="_blank" rel="noopener noreferrer">WhatsApp {ARCAV_WHATSAPP_DISPLAY}</a>}
            <a href={`mailto:${BRAND.email}`}>{BRAND.email}</a>
          </dd>
        </div>
      </dl>
    </div>

    {disclaimer && <p class="site-footer__disclaimer">{disclaimer}</p>}

    <div class="site-footer__bottom">
      <p>{home.footer.copyright}</p>
      <ul role="list" class="site-footer__social">
        {BRAND.social.map((item) => (
          <li>
            <a href={item.href} target="_blank" rel="noopener noreferrer">
              {item.name}
              <Icon name="external" />
              <span class="visually-hidden">(abre em nova aba)</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--dark);
    color: var(--on-dark);
    padding-block: clamp(2.25rem, 1.75rem + 1.5vw, 3rem) 1.25rem;
  }

  .site-footer a {
    color: var(--on-dark);
    text-decoration: none;
  }

  .site-footer a:hover {
    text-decoration: underline;
  }

  .site-footer__top {
    display: grid;
    gap: 1.75rem;
  }

  .site-footer__brand p {
    margin-top: 0.5rem;
    color: var(--on-dark-muted);
    max-width: 22rem;
  }

  .site-footer__links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.375rem 1.5rem;
    align-content: start;
    font-size: var(--text-sm);
  }

  .site-footer__facts {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    font-size: var(--text-sm);
  }

  .site-footer__facts dt {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--on-dark-muted);
    margin-bottom: 0.25rem;
  }

  .site-footer__facts dd {
    margin: 0;
  }

  .site-footer__contact {
    display: grid;
    gap: 0.25rem;
  }

  .flow--dark {
    color: var(--on-dark);
    font-size: 0.9375rem;
  }

  .site-footer__disclaimer {
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--on-dark-line);
    font-size: var(--text-sm);
    color: var(--on-dark-muted);
    max-width: 48rem;
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--on-dark-line);
    font-size: var(--text-sm);
    color: var(--on-dark-muted);
  }

  .site-footer__social {
    display: flex;
    gap: 1.5rem;
  }

  .site-footer__social a {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }

  .site-footer__social :global(svg) {
    width: 0.875rem;
    height: 0.875rem;
    opacity: 0.7;
  }

  @media (min-width: 800px) {
    .site-footer__top {
      grid-template-columns: 1fr 1.4fr 1.2fr;
      gap: 2.5rem;
    }
  }
</style>
