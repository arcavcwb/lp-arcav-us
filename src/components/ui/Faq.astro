---
import Icon from './Icon.astro';
import { ui } from '@data';

interface Props {
  items: Array<{ q: string; a: string }>;
  title?: string;
  id?: string;
  /** Fundo cinza (padrão) ou branco, para alternar com a seção anterior. */
  muted?: boolean;
}

const { items, title = ui.faq.title, id = 'faq-title', muted = true } = Astro.props;
---
<section class:list={['section faq', { 'section--muted': muted }]} aria-labelledby={id}>
  <div class="shell faq__grid">
    <h2 class="h2" id={id}>{title}</h2>
    <div class="faq__list">
      {items.map((item) => (
        <details class="faq__item">
          <summary class="faq__question">
            {item.q}
            <Icon name="plus" class="faq__icon" />
          </summary>
          <p class="faq__answer">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
