---
import Icon from './Icon.astro';
import { ui } from '../../data/ui';

interface Props {
  items: Array<{ q: string; a: string }>;
  title?: string;
  id?: string;
  /** Fundo cinza (padrão) ou branco, para alternar com a seção anterior. */
  muted?: boolean;
}

const { items, title = ui.faq.title, id = 'faq-title', muted = true } = Astro.props;
---
<section class:list={['section', { 'section--muted': muted }]} aria-labelledby={id}>
  <div class="shell grid gap-8 lg:grid-cols-aside lg:gap-12">
    <h2 class="h2" id={id}>{title}</h2>
    <div class="border-t border-ink">
      {items.map((item) => (
        <details class="faq__item group border-b border-line-strong">
          <summary class="flex min-h-11 cursor-pointer items-center justify-between gap-4 py-4.5 text-lg font-title tracking-tight">
            {item.q}
            <Icon name="plus" class="size-5 flex-none text-muted transition-transform duration-base ease-out group-open:rotate-45" />
          </summary>
          <p class="max-w-xl pb-5 text-muted">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
