---
// O lado da loja: o pedido chega pronto ao WhatsApp e o atendimento continua com o comerciante.
// Ilustração, não captura de tela. Com `live`, espelha o pedido montado no PhoneDemo da página
// (evento `demo:order`, ou só ao enviar com `trigger="send"`); sem pedido, convida a montar um.
// Sem `live`, mostra o pedido fixo. O script (initOrderMessages) é ligado por quem usa a ilustração.
import Icon from './Icon.astro';
import { ui, type IllustrativeOrder } from '@data';
import { formatOrderLine, initials } from '@lib';

interface Props {
  order: IllustrativeOrder;
  greeting?: string;
  reply?: string;
  note?: string;
  /** Espelha a demo da página: texto e link enquanto não há pedido, e a legenda do modo ao vivo. */
  live?: { empty: string; cta?: { href: string; label: string }; caption?: string };
  /** Com `live`: acompanhar cada mudança do carrinho (padrão) ou só o pedido enviado. */
  trigger?: 'change' | 'send';
}

const copy = ui.orderMessage;
const { order, greeting = copy.greeting, reply = copy.reply, note = copy.note, live, trigger = 'change' } = Astro.props;
const caption = live ? live.caption : order.caption;
---
<figure class="order-message" data-order-message={live ? trigger : undefined}>
  <div class="order-message__card">
    <div class="order-message__head">
      <span class="order-message__avatar" aria-hidden="true">{initials(copy.customer).charAt(0)}</span>
      <p class="order-message__who">
        <strong class="order-message__name">{copy.customer}</strong>
        <span class="order-message__channel">{copy.channel}</span>
      </p>
    </div>

    {live && (
      <div class="order-message__empty" data-order-empty>
        <p>{live.empty}</p>
        {live.cta && (
          <a class="btn btn--ghost btn--sm" href={live.cta.href}>
            {live.cta.label}
            <Icon name="arrow-right" />
          </a>
        )}
      </div>
    )}

    <div class="order-message__thread" data-order-thread hidden={live ? true : undefined} aria-live={live ? 'polite' : undefined}>
      <div class="order-message__bubble order-message__bubble--in">
        <p>{greeting}</p>
        <ul role="list" class="order-message__lines" data-order-lines>
          {order.items.map((item) => <li>{formatOrderLine(item)}</li>)}
        </ul>
      </div>
      <div class="order-message__bubble order-message__bubble--out">
        <p>{reply}</p>
      </div>
    </div>

    <p class="order-message__note">
      <Icon name="check" class="order-message__check" />
      {note}
    </p>
  </div>
  {caption && <figcaption class="order-message__caption">{caption}</figcaption>}
</figure>
