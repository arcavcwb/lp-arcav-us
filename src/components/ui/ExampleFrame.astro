---
// Captura de um exemplo ilustrativo dentro de uma janela de navegador, com link para o exemplo.
// Sem `href`, a janela vira espaço reservado (ainda não há exemplo baseado em projeto real).
import { EXAMPLE_IMAGE, ui } from '@data';

interface Props {
  /** null = espaço reservado: ainda não há exemplo baseado em projeto real. */
  href: string | null;
  image: string | null;
  client: string | null;
  eager?: boolean;
}

const { href, image, client, eager = false } = Astro.props;
const copy = ui.exampleFrame;
const host = new URL(Astro.site!).host;
const url = href ? `${host}${href.split('#')[0]}` : host;

const Window = href ? 'a' : 'div';
const windowAttrs = href ? { href, 'aria-label': copy.openLabel(client) } : {};
---
<figure class="example-frame float">
  <Window
    class:list={['example-frame__window', href ? 'example-frame__window--link' : 'example-frame__window--placeholder']}
    {...windowAttrs}
  >
    <span class="example-frame__bar" aria-hidden="true">
      <span class="example-frame__dots"><i class="example-frame__dot"></i><i class="example-frame__dot"></i><i class="example-frame__dot"></i></span>
      <span class="example-frame__url">{url}</span>
    </span>
    {href && image ? (
      <img
        class="example-frame__image"
        src={image}
        alt=""
        width={EXAMPLE_IMAGE.width}
        height={EXAMPLE_IMAGE.height}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
    ) : href ? (
      <span class="example-frame__empty">{copy.open}</span>
    ) : (
      <span class="example-frame__empty">
        <strong class="example-frame__empty-title">{copy.pendingTitle}</strong>
        <span class="example-frame__empty-text">{copy.pendingText}</span>
      </span>
    )}
  </Window>
  <figcaption class="example-frame__caption">{href ? copy.caption(client) : copy.pendingCaption}</figcaption>
</figure>
