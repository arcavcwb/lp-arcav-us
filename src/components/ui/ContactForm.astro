---
// Formulário de contato. Com DIRECT_SEND, envia pelo próprio site (/api/contato: n8n ou
// Cloudflare Email) e, se falhar, monta a mensagem e abre o WhatsApp (ou o e-mail).
// Sem DIRECT_SEND, o botão diz "Enviar pelo WhatsApp" e vai direto para lá: o site não promete
// um envio que ainda não faz.
// Na variante geral, "O que você precisa?" lista os nomes curtos dos cinco serviços e "Ainda não sei";
// `need` (slug do serviço) já chega marcado, e a escolha entra na mensagem.
import Icon from './Icon.astro';
import BrandIcon from './BrandIcon.astro';
import { BRAND, SERVICES, ui, type FormField } from '@data';
import { EXTERNAL_LINK, ARCAV_WHATSAPP, ARCAV_WHATSAPP_DISPLAY, DIRECT_SEND, RESPONSE_TIME, whatsappLink } from '@lib';

type Variant = 'general' | 'store';

interface Props {
  subject: string;
  /** general: contato da home e das soluções. store: conversa sobre um site de pedidos (comércios). */
  variant?: Variant;
  /** Pergunta do campo de mensagem (variante general). */
  messageLabel?: string;
  messagePlaceholder?: string;
  submit?: string;
  /** Serviço já marcado em "O que você precisa?" (slug de solutions.ts). */
  need?: string;
}

const { subject, variant = 'general', messageLabel, messagePlaceholder, submit, need } = Astro.props;
const copy = ui.contactForm;
const uid = variant === 'store' ? 'sf' : 'cf';

const wa = whatsappLink();
/** Sem envio direto e com WhatsApp: o formulário só prepara a mensagem para o WhatsApp. */
const viaWhatsapp = !DIRECT_SEND && Boolean(wa);

/** Campos da variante; na geral, a pergunta da mensagem pode vir da página. */
const fields: FormField[] =
  variant === 'store'
    ? copy.store
    : copy.general.map((field): FormField => {
        if (field.id === 'message') return { ...field, label: messageLabel ?? field.label, placeholder: messagePlaceholder ?? field.placeholder };
        if (field.id === 'reply' && !viaWhatsapp) return copy.replyDirect;
        return field;
      });

/** Opções de "O que você precisa?": os nomes curtos dos serviços e "Ainda não sei". */
const choices = [...SERVICES.map((s) => ({ value: s.label, slug: s.slug })), { value: copy.unsure, slug: '' }];
const submitLabel = viaWhatsapp ? copy.submit.whatsapp : (submit ?? copy.submit[variant]);
const response = RESPONSE_TIME ? ui.responseTime(RESPONSE_TIME) : null;
---
<form
  class="contact-form"
  action={`mailto:${BRAND.email}`}
  method="post"
  enctype="text/plain"
  novalidate
  data-contact-form
  data-variant={variant}
  data-email={BRAND.email}
  data-whatsapp={ARCAV_WHATSAPP ?? ''}
  data-subject={subject}
  data-direct={DIRECT_SEND ? 'true' : 'false'}
>
  {fields.map((field, index) => {
    const id = `${uid}-${field.id}`;
    /** O formulário vive numa janela: ao abrir, o cursor já está no primeiro campo. */
    const autofocus = index === 0;
    const describedBy = [field.hint && `${id}-hint`, field.required && `${id}-error`].filter(Boolean).join(' ') || undefined;
    if (field.type === 'choices') {
      return (
        <fieldset class="field field--choices" aria-describedby={describedBy} data-choices={field.id} data-required={field.required ? 'true' : undefined} data-error-message={field.error}>
          <legend class="field__legend">{field.label}</legend>
          <div class="choices">
            {choices.map((choice, n) => (
              <label class="choice">
                <input class="choice__input" type="checkbox" name={field.id} value={choice.value} checked={Boolean(need) && choice.slug === need} autofocus={autofocus && n === 0} data-choice={choice.slug} />
                <span class="choice__label">{choice.value}</span>
              </label>
            ))}
          </div>
          {field.required && <p class="field__error" id={`${id}-error`} data-error-slot></p>}
        </fieldset>
      );
    }
    return (
      <div class="field">
        <label for={id}>
          {field.label}
          {!field.required && !field.bare && <span class="field__optional">{` ${copy.optional}`}</span>}
        </label>
        {field.type === 'textarea' ? (
          <textarea
            id={id}
            name={field.id}
            rows={field.rows}
            autofocus={autofocus}
            required={field.required}
            placeholder={field.placeholder}
            aria-describedby={describedBy}
            data-field={field.id}
            data-error-message={field.error}
          />
        ) : (
          <input
            id={id}
            name={field.id}
            type="text"
            autofocus={autofocus}
            autocomplete={field.autocomplete}
            inputmode={field.inputmode}
            required={field.required}
            placeholder={field.placeholder}
            aria-describedby={describedBy}
            data-field={field.id}
            data-error-message={field.error}
          />
        )}
        {field.hint && <p class="field__hint" id={`${id}-hint`}>{field.hint}</p>}
        {field.required && <p class="field__error" id={`${id}-error`} data-error-slot></p>}
      </div>
    );
  })}

  <div class="field--trap visually-hidden" aria-hidden="true">
    <label for={`${uid}-website`}>{copy.trap}</label>
    <input id={`${uid}-website`} name="website" type="text" tabindex="-1" autocomplete="off" data-field="website" />
  </div>

  <button class="btn btn--primary contact-form__submit" type="submit" data-submit>
    {viaWhatsapp ? <BrandIcon name="whatsapp" mono /> : <Icon name="send" />}
    <span data-submit-label>{submitLabel}</span>
  </button>

  <div class="sent" data-sent hidden tabindex="-1" role="status">
    <Icon name="check" />
    <div>
      <p class="sent__title">{copy.sent.title}</p>
      <p>{copy.sent.text}</p>
    </div>
  </div>

  <div class="composed" data-composed hidden tabindex="-1">
    <p class="composed__title" role="status" data-composed-status></p>
    <pre class="composed__text" data-composed-text></pre>
    <div class="composed__actions">
      <a class="btn btn--ghost btn--sm" data-composed-open href="#">
        <Icon name="mail" />
        {copy.composed.reopen}
      </a>
      <button class="btn btn--ghost btn--sm" type="button" data-composed-copy>
        <Icon name="copy" />
        <span data-copy-label>{copy.composed.copy}</span>
      </button>
    </div>
  </div>

  <p class="contact-form__note">
    {viaWhatsapp ? (
      <Fragment>
        {copy.note.whatsappOpens}{response && ` ${response}`}{' '}
        {copy.note.privacy}{' '}
        {copy.note.emailLead}{' '}
        <a href={`mailto:${BRAND.email}`}>{BRAND.email}</a>.
      </Fragment>
    ) : wa ? (
      <Fragment>
        {response && `${response} `}{copy.note.privacy}{' '}
        {copy.note.whatsappLead}{' '}
        <a href={wa} {...EXTERNAL_LINK}>{ARCAV_WHATSAPP_DISPLAY}</a>{' '}
        {copy.note.emailOr}{' '}
        <a href={`mailto:${BRAND.email}`}>{BRAND.email}</a>.
      </Fragment>
    ) : (
      <Fragment>
        {response && `${response} `}{copy.note.privacy}{' '}
        {copy.note.emailDirectLead}{' '}
        <a href={`mailto:${BRAND.email}`}>{BRAND.email}</a>.
      </Fragment>
    )}
  </p>
</form>

<script>
  import { initContactForms } from '@scripts/contact-form';

  initContactForms();
</script>
