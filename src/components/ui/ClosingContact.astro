---
// Bloco final escuro: chamada, quem responde (Armando), alternativas e o formulário.
import ContactForm from './ContactForm.astro';
import Portrait from './Portrait.astro';
import { BRAND } from '../../data/site';
import { ARCAV_WHATSAPP_DISPLAY, RESPONSE_TIME, whatsappLink } from '../../lib/contact';

interface Props {
  title: string;
  text: string;
  subject: string;
  variant?: 'general' | 'store';
  messageLabel?: string;
  messagePlaceholder?: string;
  submit?: string;
  /** Mensagem pronta para o link de WhatsApp alternativo. */
  waMessage?: string;
}

const { title, text, subject, variant = 'general', messageLabel, messagePlaceholder, submit, waMessage } = Astro.props;
const wa = whatsappLink(waMessage);
---
<section class="section section--dark" id="contato" aria-labelledby="contato-title">
  <div class="container">
    <div class="closing">
      <div class="closing__copy">
        <h2 class="h2" id="contato-title">{title}</h2>
        <p class="lead">{text}</p>
        <div class="responder">
          <Portrait size="avatar" />
          <p>
            <strong>Quem responde é o Armando Castro</strong>
            <span>Aqui de Curitiba. Resposta {RESPONSE_TIME}.</span>
          </p>
        </div>
        <p class="small">
          {wa ? (
            <Fragment>
              Se preferir, chame no WhatsApp <a href={wa} target="_blank" rel="noopener noreferrer">{ARCAV_WHATSAPP_DISPLAY}</a>
              ou escreva para <a href={`mailto:${BRAND.email}`}>{BRAND.email}</a>.
            </Fragment>
          ) : (
            <Fragment>
              Se preferir, escreva para <a href={`mailto:${BRAND.email}`}>{BRAND.email}</a>.
            </Fragment>
          )}
        </p>
      </div>
      <div class="card closing__form">
        <ContactForm
          subject={subject}
          variant={variant}
          messageLabel={messageLabel}
          messagePlaceholder={messagePlaceholder}
          submit={submit}
        />
      </div>
    </div>
  </div>
</section>

<style>
  .closing {
    display: grid;
    gap: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    align-items: start;
  }

  .closing__copy {
    display: grid;
    gap: 1.25rem;
    max-width: 34rem;
  }

  .closing__copy .small a {
    color: var(--on-dark);
  }

  .responder {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding-block: 1rem;
    border-block: 1px solid var(--on-dark-line);
  }

  .responder p {
    display: grid;
    line-height: 1.4;
  }

  .responder strong {
    color: var(--on-dark);
    font-weight: 600;
  }

  .responder span {
    font-size: var(--text-sm);
    color: var(--on-dark-muted);
  }

  .closing__form {
    color: var(--ink);
    border-color: transparent;
  }

  @media (min-width: 880px) {
    .closing {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    }
  }
</style>
