---
// Bloco final escuro: a chamada à esquerda; à direita, quem responde, como falar e o botão que abre
// o formulário numa janela (popover, sem JavaScript: botão abre; X, Esc ou toque fora fecham).
// O cabeçalho e o hero apontam para a mesma janela (ANCHOR.contactForm).
// `channels` troca a frase "Se preferir…" pela lista de canais (WhatsApp, e-mail, cidade).
// `feature` (home) usa o título maior.
// Com o número da ARCAV (2026-11-24), a ação principal abre o WhatsApp com a mensagem pronta e o
// formulário vira a segunda opção ("Prefiro escrever aqui"); a linha de apoio oferece o e-mail.
// Sem número, o botão principal abre o formulário.
// `data-wa-bar-hide`: com a seção à vista, a barra fixa do WhatsApp (WhatsAppBar.astro) se esconde.
import ContactForm from './ContactForm.astro';
import Avatar from './Avatar.astro';
import BrandIcon from './BrandIcon.astro';
import Icon from './Icon.astro';
import { ANCHOR, BRAND, ui } from '@data';
import { EXTERNAL_LINK, ARCAV_WHATSAPP_DISPLAY, RESPONSE_TIME, whatsappLink } from '@lib';

interface Props {
  title: string;
  text: string;
  subject: string;
  variant?: 'general' | 'store';
  messageLabel?: string;
  messagePlaceholder?: string;
  submit?: string;
  /** Mensagem pronta para o link de WhatsApp alternativo. */
  waMessage?: string;
  channels?: boolean;
  feature?: boolean;
  /** Serviço já marcado no formulário (slug de solutions.ts). */
  need?: string;
}

const {
  title,
  text,
  subject,
  variant = 'general',
  messageLabel,
  messagePlaceholder,
  submit,
  waMessage,
  channels = false,
  feature = false,
  need,
} = Astro.props;
const wa = whatsappLink(waMessage);
const copy = ui.closingContact;
const dialog = ui.contactDialog;
const dialogId = ANCHOR.contactForm;
/** O botão que abre a janela diz o mesmo que o envio da página (ex.: "Quero uma loja assim"). */
const openLabel = submit ?? (variant === 'store' ? ui.contactForm.submit.store : dialog.open);
---
<section class="section section--dark closing has-orbs" id={ANCHOR.contact} aria-labelledby="contato-title" data-wa-bar-hide>
  <div class="orbs" aria-hidden="true">
    <span class="orbs__orb orbs__orb--blue"></span>
    <span class="orbs__orb orbs__orb--amber"></span>
  </div>
  <div class="shell closing__grid">
    <div class="closing__intro">
      <h2 class:list={['h2', { 'h2--feature': feature }]} id="contato-title">{title}</h2>
      <p class="lead">{text}</p>
    </div>

    <div class="closing__aside glass glass--dark">
      <div class="closing__responder">
        <Avatar />
        <p class="closing__responder-text">
          <strong class="closing__responder-name">{copy.responder}</strong>
          <span class="closing__responder-place">{copy.place}{RESPONSE_TIME && ` ${ui.responseTime(RESPONSE_TIME)}`}</span>
        </p>
      </div>

      {channels ? (
        <ul role="list" class="closing__channels">
          {wa && (
            <li class="closing__channel">
              <Icon name="chat" class="closing__channel-icon" />
              <a class="closing__channel-link" href={wa} {...EXTERNAL_LINK}>{ui.whatsapp(ARCAV_WHATSAPP_DISPLAY)}</a>
            </li>
          )}
          <li class="closing__channel">
            <Icon name="mail" class="closing__channel-icon" />
            <a class="closing__channel-link" href={`mailto:${BRAND.email}`}>{BRAND.email}</a>
          </li>
          <li class="closing__channel">
            <Icon name="pin" class="closing__channel-icon" />
            <span>{BRAND.location}</span>
          </li>
        </ul>
      ) : (
        <p class="small">
          {copy.emailLead}{' '}
          <a href={`mailto:${BRAND.email}`}>{BRAND.email}</a>.
        </p>
      )}

      {wa ? (
        <div class="closing__actions">
          <a class="btn btn--primary closing__open" href={wa} {...EXTERNAL_LINK}>
            <BrandIcon name="whatsapp" mono />
            {ui.whatsappCta}
          </a>
          <button class="btn btn--ghost closing__open" type="button" popovertarget={dialogId}>
            {dialog.alt}
          </button>
        </div>
      ) : (
        <div>
          <button class="btn btn--primary closing__open" type="button" popovertarget={dialogId}>
            {openLabel}
            <Icon name="arrow-right" />
          </button>
        </div>
      )}
    </div>
  </div>

  <div class="contact-dialog" id={dialogId} popover role="dialog" aria-labelledby={`${dialogId}-title`}>
    <div class="contact-dialog__panel">
      <div class="contact-dialog__head">
        <h2 class="h3 contact-dialog__title" id={`${dialogId}-title`}>{dialog.title}</h2>
        <button class="contact-dialog__close" type="button" popovertarget={dialogId} popovertargetaction="hide" aria-label={dialog.close}>
          <Icon name="close" class="contact-dialog__close-icon" />
        </button>
      </div>
      <ContactForm
        subject={subject}
        variant={variant}
        messageLabel={messageLabel}
        messagePlaceholder={messagePlaceholder}
        submit={submit}
        need={need}
      />
    </div>
  </div>
</section>
