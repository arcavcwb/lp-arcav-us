---
// Bloco final escuro: chamada, quem responde (Armando), alternativas e o formulário.
import ContactForm from './ContactForm.astro';
import Avatar from './Avatar.astro';
import { BRAND } from '../../data/site';
import { ANCHOR } from '../../data/anchors';
import { ui } from '../../data/ui';
import { ARCAV_WHATSAPP_DISPLAY, RESPONSE_TIME, whatsappLink } from '../../lib/contact';

interface Props {
  title: string;
  text: string;
  subject: string;
  variant?: 'general' | 'store';
  messageLabel?: string;
  messagePlaceholder?: string;
  submit?: string;
  /** Mensagem pronta para o link de WhatsApp alternativo. */
  waMessage?: string;
}

const { title, text, subject, variant = 'general', messageLabel, messagePlaceholder, submit, waMessage } = Astro.props;
const wa = whatsappLink(waMessage);
const copy = ui.closingContact;
---
<section class="section section--dark" id={ANCHOR.contact} aria-labelledby="contato-title">
  <div class="shell">
    <div class="grid items-start gap-split-tight lg:grid-cols-form">
      <div class="grid max-w-lg gap-5">
        <h2 class="h2" id="contato-title">{title}</h2>
        <p class="lead">{text}</p>
        <div class="flex items-center gap-3.5 border-y border-on-dark-line py-4">
          <Avatar />
          <p class="grid leading-label">
            <strong class="font-semibold text-on-dark">{copy.responder}</strong>
            <span class="text-sm text-on-dark-muted">{copy.place}{RESPONSE_TIME && ` ${ui.responseTime(RESPONSE_TIME)}`}</span>
          </p>
        </div>
        <p class="small">
          {wa ? (
            <Fragment>
              {copy.whatsappLead}{' '}
              <a href={wa} target="_blank" rel="noopener noreferrer">{ARCAV_WHATSAPP_DISPLAY}</a>{' '}
              {copy.emailOr}{' '}
              <a href={`mailto:${BRAND.email}`}>{BRAND.email}</a>.
            </Fragment>
          ) : (
            <Fragment>
              {copy.emailLead}{' '}
              <a href={`mailto:${BRAND.email}`}>{BRAND.email}</a>.
            </Fragment>
          )}
        </p>
      </div>
      <div class="card closing__form border-transparent text-ink">
        <ContactForm
          subject={subject}
          variant={variant}
          messageLabel={messageLabel}
          messagePlaceholder={messagePlaceholder}
          submit={submit}
        />
      </div>
    </div>
  </div>
</section>
