---
// Demonstração interativa: o visitante monta um pedido de exemplo e vê a mensagem
// do WhatsApp ficar pronta. Sem JavaScript, mostra o pedido inicial estático.
// Com `guide`, um guia de três passos acompanha o uso e o "+" se destaca uma vez ao entrar na tela
// (ou ao tocar num link para o id da demo). A cada mudança, dispara `demo:order` com os itens,
// que um OrderMessage `live` pode espelhar.
import Icon from './Icon.astro';
import { ui, type DemoProduct } from '@data';
import { formatOrderLine, orderSummary, totalQty } from '@lib';

interface Props {
  products: DemoProduct[];
  storeName?: string;
  storeNote?: string;
  greeting?: string;
  caption: string;
  class?: string;
  id?: string;
  /** Próximo passo que aparece abaixo do celular depois de "Enviar pelo WhatsApp". */
  /** `popover`: id da janela que o botão abre (ex.: o formulário); sem ele, `href` vira um link. */
  next?: { label: string; href?: string; popover?: string };
  /** Mostra o guia "Experimente" com os três passos e o destaque no primeiro "+". */
  guide?: boolean;
}

const copy = ui.phoneDemo;
const {
  products,
  storeName = copy.storeName,
  storeNote = copy.storeNote,
  greeting = copy.greeting,
  caption,
  class: className,
  id,
  next,
  guide = false,
} = Astro.props;

const initial = products.map((p) => ({ ...p, qty: p.qty ?? 0 }));
const total = totalQty(initial);
---
<figure
  id={id}
  class:list={['phone-demo', className]}
  data-phone-demo
  data-state="store"
  data-guide={guide ? '' : undefined}
  style={{ '--rows': initial.length }}
>
  {guide && (
    <div class="demo-guide">
      <p class="demo-guide__title">{copy.guideTitle}</p>
      <ol role="list" class="demo-guide__steps" aria-label={copy.guideLabel}>
        {copy.guideSteps.map((label, i) => (
          <li data-guide-step={i + 1} aria-current={i === 0 ? 'step' : undefined}>
            <span class="demo-guide__n" aria-hidden="true">
              <span class="demo-guide__num">{i + 1}</span>
              <Icon name="check" class="demo-guide__check" />
            </span>
            {label}
          </li>
        ))}
      </ol>
    </div>
  )}
  <div class="phone">
    <div class="phone__screen" role="group" aria-label={copy.screen}>
      <span class="phone__notch" aria-hidden="true"></span>

      <div class="screen screen--store" data-view="store">
        <div class="app-bar">
          <div>
            <strong class="app-bar__title">{storeName}</strong>
            <span class="app-bar__note">{storeNote}</span>
          </div>
          <span class="cart-pill" aria-hidden="true">
            <Icon name="cart" />
            <span class="tnum" data-count>{total}</span>
          </span>
        </div>

        <ul role="list" class="products">
          {initial.map((p) => (
            <li class="product" data-product data-name={p.name} data-qty={p.qty}>
              <span class="product__text">
                <strong>{p.name}</strong>
                <span>{p.detail}</span>
              </span>
              <span class="stepper">
                <button type="button" data-step="-1" aria-label={copy.remove(p.name)}>
                  <Icon name="minus" />
                </button>
                <span class="stepper__qty tnum" data-qty-label>{p.qty}</span>
                <button type="button" data-step="1" aria-label={copy.add(p.name)}>
                  <Icon name="plus" />
                </button>
              </span>
            </li>
          ))}
        </ul>

        <div class="checkout">
          <span class="checkout__summary" data-summary aria-live="polite">{orderSummary(total)}</span>
          <button type="button" class="btn btn--primary checkout__btn" data-review disabled={total === 0}>
            {copy.review}
            <Icon name="arrow-right" />
          </button>
        </div>
      </div>

      <div class="screen screen--message" data-view="message" aria-hidden="true" inert>
        <div class="app-bar app-bar--message">
          <button type="button" class="back" data-back aria-label={copy.back}>
            <Icon name="back" />
          </button>
          <strong class="app-bar__title">{copy.ready}</strong>
        </div>

        <div class="bubble">
          <p>{greeting}</p>
          <ul role="list" class="bubble__lines tnum" data-lines>
            {initial.filter((p) => p.qty > 0).map((p) => <li>{formatOrderLine(p)}</li>)}
          </ul>
        </div>

        <div class="send">
          <p class="send__hint" data-send-status role="status">{copy.sendHint}</p>
          <button type="button" class="btn send__btn" data-send>
            <Icon name="send" />
            {copy.send}
          </button>
        </div>
      </div>
    </div>
  </div>
  {next && (
    <div class="phone-demo__next" data-next hidden>
      {next.popover ? (
        <button class="btn btn--primary" type="button" popovertarget={next.popover} data-analytics-event="demo_next_click">
          {next.label}
          <Icon name="arrow-right" />
        </button>
      ) : (
        <a class="btn btn--primary" href={next.href} data-analytics-event="demo_next_click">
          {next.label}
          <Icon name="arrow-right" />
        </a>
      )}
    </div>
  )}
  <figcaption>{caption}</figcaption>
</figure>

<script>
  // O script da demo só carrega quando ela chega perto da tela: na home ela fica abaixo da dobra e
  // não disputa a rede com o hero (LCP). Na página de comércio ela está no hero e carrega logo.
  // Sem IntersectionObserver, carrega na hora.
  const NEAR_SCREEN = '200px 0px';
  const demos = document.querySelectorAll<HTMLElement>('[data-phone-demo]');
  const load = () => import('@scripts/phone-demo').then((m) => m.initPhoneDemos());

  if (demos.length && !('IntersectionObserver' in window)) {
    load();
  } else if (demos.length) {
    const watcher = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        watcher.disconnect();
        load();
      },
      { rootMargin: NEAR_SCREEN },
    );
    demos.forEach((demo) => watcher.observe(demo));
  }
</script>
