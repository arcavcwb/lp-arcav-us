---
import type { Copy, Lang } from '../i18n/translations';

interface Props {
  contact: Copy['contact'];
  lang: Lang;
}

const { contact, lang } = Astro.props;
const messages = JSON.stringify({ errors: contact.errors, sending: contact.sending, submit: contact.submit, success: contact.success });
---
<section id="contacto" class="contact" aria-labelledby="contact-title">
  <div class="wrap contact__grid">
    <div class="contact__intro">
      <h2 id="contact-title">{contact.title}</h2>
      <p>{contact.lead}</p>
      <p class="contact__privacy">{contact.privacy}</p>
    </div>

    <form class="form" data-contact-form data-lang={lang} data-messages={messages} novalidate>
      <div class="field">
        <label for="c-nombre">{contact.nombre.label}</label>
        <input id="c-nombre" name="nombre" type="text" autocomplete="name" maxlength="120" required placeholder={contact.nombre.placeholder} aria-describedby="c-nombre-error" />
        <p class="field__error" id="c-nombre-error" hidden></p>
      </div>

      <div class="field">
        <label for="c-contacto">{contact.contacto.label}</label>
        <input id="c-contacto" name="contacto" type="text" inputmode="email" autocomplete="email" maxlength="160" required placeholder={contact.contacto.placeholder} aria-describedby="c-contacto-error" />
        <p class="field__error" id="c-contacto-error" hidden></p>
      </div>

      <div class="field">
        <label for="c-proceso">{contact.proceso.label}</label>
        <textarea id="c-proceso" name="proceso" rows="5" maxlength="2000" required placeholder={contact.proceso.placeholder} aria-describedby="c-proceso-error"></textarea>
        <p class="field__error" id="c-proceso-error" hidden></p>
      </div>

      <div class="field field--trap" aria-hidden="true">
        <label for="c-sitio">{contact.honeypot}</label>
        <input id="c-sitio" name="sitio_web" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <div class="form__foot">
        <button class="form__submit" type="submit">
          <span data-submit-label>{contact.submit}</span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" /></svg>
        </button>
        <p class="form__status" role="status" aria-live="polite" data-status></p>
      </div>
    </form>
  </div>
</section>

<script>
  type FieldName = 'nombre' | 'contacto' | 'proceso';
  type Messages = {
    errors: {
      nombre: Record<string, string>;
      contacto: Record<string, string>;
      proceso: Record<string, string>;
      generic: string;
      network: string;
    };
    sending: string;
    submit: string;
    success: string;
  };

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');

  if (form) {
    const messages = JSON.parse(form.dataset.messages ?? '{}') as Messages;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const submitLabel = form.querySelector<HTMLElement>('[data-submit-label]')!;
    const fields: FieldName[] = ['nombre', 'contacto', 'proceso'];

    const control = (name: FieldName) => form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement;

    const setError = (name: FieldName, code?: string) => {
      const input = control(name);
      const out = form.querySelector<HTMLElement>(`#c-${name}-error`)!;
      if (code) {
        input.setAttribute('aria-invalid', 'true');
        out.textContent = messages.errors[name][code] ?? messages.errors.generic;
        out.hidden = false;
      } else {
        input.removeAttribute('aria-invalid');
        out.textContent = '';
        out.hidden = true;
      }
    };

    const validate = (name: FieldName, value: string): string | undefined => {
      const v = value.trim();
      if (!v) return 'required';
      if (name === 'nombre') {
        if (v.length < 2) return 'too_short';
        if (v.length > 120) return 'too_long';
      }
      if (name === 'contacto') {
        if (v.length > 160) return 'too_long';
        const email = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v);
        const phone = v.replace(/\D/g, '').length >= 8;
        if (v.length < 5 || (!email && !phone)) return 'invalid';
      }
      if (name === 'proceso') {
        if (v.length < 10) return 'too_short';
        if (v.length > 2000) return 'too_long';
      }
      return undefined;
    };

    fields.forEach((name) => {
      control(name).addEventListener('blur', () => {
        const input = control(name);
        if (input.value.trim() || input.hasAttribute('aria-invalid')) setError(name, validate(name, input.value));
      });
    });

    const setBusy = (busy: boolean) => {
      submit.disabled = busy;
      submit.setAttribute('aria-busy', String(busy));
      submitLabel.textContent = busy ? messages.sending : messages.submit;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      status.textContent = '';
      form.classList.remove('is-sent', 'has-error');

      const invalid = fields.map((name) => [name, validate(name, control(name).value)] as const).filter(([, code]) => code);
      fields.forEach((name) => setError(name));
      if (invalid.length) {
        invalid.forEach(([name, code]) => setError(name, code));
        control(invalid[0][0]).focus();
        return;
      }

      setBusy(true);
      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            nombre: control('nombre').value.trim(),
            contacto: control('contacto').value.trim(),
            proceso: control('proceso').value.trim(),
            idioma: form.dataset.lang,
            sitio_web: (form.elements.namedItem('sitio_web') as HTMLInputElement).value,
          }),
        });
        const data = await res.json().catch(() => ({}));

        if (res.ok && data.ok) {
          form.reset();
          form.classList.add('is-sent');
          status.textContent = messages.success;
          return;
        }

        if (res.status === 400 && data.error === 'validation' && data.fields) {
          const entries = Object.entries(data.fields) as [FieldName, string][];
          entries.forEach(([name, code]) => setError(name, code));
          if (entries[0]) control(entries[0][0]).focus();
          return;
        }

        form.classList.add('has-error');
        status.textContent = messages.errors.generic;
      } catch {
        form.classList.add('has-error');
        status.textContent = messages.errors.network;
      } finally {
        setBusy(false);
      }
    });
  }
</script>

<style>
  .contact {
    padding-block: var(--space-9);
    background: var(--here);
    border-top: 4px solid var(--ink);
  }

  .contact__grid {
    display: grid;
    gap: var(--space-7);
  }

  @media (min-width: 960px) {
    .contact__grid {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      align-items: start;
    }
  }

  .contact__intro {
    display: grid;
    gap: var(--space-4);
    max-width: 30rem;
  }

  .contact__intro h2 {
    font-size: clamp(2.6rem, 5vw, 4.4rem);
  }

  .contact__intro p {
    font-size: 1.25rem;
  }

  .contact__privacy {
    font-family: var(--font-sign);
    font-weight: 600;
    font-size: 1.1rem !important;
  }

  .form {
    display: grid;
    gap: var(--space-5);
  }

  .field {
    display: grid;
    gap: var(--space-2);
  }

  .field label {
    font-family: var(--font-sign);
    font-weight: 800;
    font-size: 1.3rem;
    line-height: 1.1;
  }

  .field input,
  .field textarea {
    width: 100%;
    padding: 0.85rem 1rem;
    background: var(--paper);
    color: var(--ink);
    border: 3px solid var(--ink);
    border-radius: 2px;
    font: inherit;
    font-size: 1.125rem;
    line-height: 1.4;
  }

  .field textarea {
    resize: vertical;
    min-height: 9rem;
  }

  .field input::placeholder,
  .field textarea::placeholder {
    color: #5f656c;
  }

  .field input:focus-visible,
  .field textarea:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 2px;
    box-shadow: none;
  }

  .field [aria-invalid='true'] {
    border-color: var(--line-landing);
    border-width: 4px;
  }

  .field__error[hidden] {
    display: none;
  }

  .field__error {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 600;
    color: #8f1710;
  }

  .field__error::before {
    content: '';
    flex: none;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    background: var(--line-landing);
    box-shadow: 0 0 0 2px var(--ink);
  }

  .field--trap {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-5);
  }

  .form__submit {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 3.5rem;
    padding: 0.7rem 1.4rem;
    background: var(--ink);
    color: var(--here);
    border: 3px solid var(--ink);
    border-radius: 2px;
    font-family: var(--font-sign);
    font-weight: 800;
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
    transition: background-color 180ms var(--ease-out), color 180ms var(--ease-out);
  }

  .form__submit svg {
    width: 1.4rem;
    height: 1.4rem;
    transition: transform 220ms var(--ease-out);
  }

  .form__submit:hover {
    background: var(--paper);
    color: var(--ink);
  }

  .form__submit:hover svg {
    transform: translateX(4px);
  }

  .form__submit:focus-visible {
    box-shadow: 0 0 0 9px var(--paper);
  }

  .form__submit:disabled {
    cursor: progress;
    background: var(--ink-soft);
    border-color: var(--ink-soft);
    color: var(--paper);
  }

  .form__status {
    font-family: var(--font-sign);
    font-weight: 800;
    font-size: 1.25rem;
    line-height: 1.2;
    max-width: 26rem;
  }

  .form.is-sent .form__status::before,
  .form.has-error .form__status::before {
    content: '';
    display: inline-block;
    width: 0.9rem;
    height: 0.9rem;
    margin-right: 0.5rem;
    border-radius: 50%;
    vertical-align: 0.05em;
  }

  .form.is-sent .form__status::before {
    background: var(--line-sistema);
    box-shadow: 0 0 0 3px var(--ink);
  }

  .form.has-error .form__status::before {
    background: var(--line-landing);
    box-shadow: 0 0 0 3px var(--ink);
  }
</style>
