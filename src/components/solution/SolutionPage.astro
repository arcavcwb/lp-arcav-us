---
// Página de uma solução da ARCAV ("o produto em cena", 2026-11-22). Hero: o texto e a ação à esquerda;
// à direita, o exemplo real quando existe ou, sem ele, o serviço em cena (a mesma cena da ficha da
// home: o aparelho no escenário com as três peças numeradas) e, numa faixa embaixo dos dois,
// "O caminho do seu cliente" com os mesmos números. Depois: para quem é (três perfis curtos) e o que está incluído (cada item com o
// ícone que o explica), como funciona (os cartões do método), dúvidas, as outras soluções em discos
// e o contato. O slot `fit` substitui "Para quem é / O que está incluído" (usado em Landing pages).
// As ações de contato abrem a janela do formulário.
import Layout from '@layouts/Layout.astro';
import { ClosingContact, ExampleFrame, Faq, Footer, Header, Icon, ProcessCards, ServiceIcon, ServicePreview } from '@components/ui';
import SolutionFlow from './SolutionFlow.astro';
import { ANCHOR, SERVICES, SOLUTION_PAGE as copy, SOLUTION_STEPS, footerNav, ui, type Solution } from '@data';
import { solutionTransition } from '@lib';

interface Props {
  solution: Solution;
}

const { solution: s } = Astro.props;
const canonical = new URL(s.path, Astro.site).href;
const others = SERVICES.filter((o) => o.slug !== s.slug);
---
<Layout title={s.meta.title} description={s.meta.description} canonical={canonical}>
  <Header cta={{ label: ui.header.cta, popover: ANCHOR.contactForm }} />

  <main id={ANCHOR.content}>
    <section class="page-hero" aria-labelledby="hero-title">
      <div class="shell page-hero__grid solution-hero__grid">
        <div>
          <h1 class="h1" id="hero-title" style={solutionTransition(s.slug)}>{s.hero.title}</h1>
          <p class="lead">{s.hero.subtitle}</p>
          <div class="page-hero__actions">
            <button class="btn btn--primary" type="button" popovertarget={ANCHOR.contactForm}>
              <Icon name="chat" />
              {s.hero.cta}
            </button>
            {s.example.path && <a class="btn btn--ghost" href={s.example.path}>{copy.exampleCta}</a>}
          </div>
          <p class="small hero-note">{copy.heroNote}</p>
        </div>
        {s.example.path || !s.journey ? (
          <ExampleFrame href={s.example.path} image={s.example.image} client={s.example.client} eager />
        ) : (
          <Fragment>
            <ServicePreview solution={s} />
            <SolutionFlow solution={s} row />
          </Fragment>
        )}
      </div>
    </section>

    {Astro.slots.has('fit') ? <slot name="fit" /> : (
    <section class="section solution-fit" aria-label={copy.fit.label}>
      <div class="shell solution-fit__grid">
        <div>
          <h2 class="h2">{copy.fit.forWho}</h2>
          <ul role="list" class="solution-fit__profiles">
            {s.forWho.map((item) => <li class="solution-fit__profile">{item}</li>)}
          </ul>
        </div>
        <div>
          <h2 class="h2">{copy.fit.includes}</h2>
          <ul role="list" class="solution-fit__pieces">
            {s.includes.map((item) => (
              <li class="solution-fit__piece">
                <span class="solution-fit__well"><Icon name={item.icon} class="solution-fit__icon" /></span>
                <span class="solution-fit__text">{item.text}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
    )}

    <section class="section section--muted" aria-labelledby="como-title">
      <div class="shell">
        <div class="section-head">
          <h2 class="h2" id="como-title">{copy.how}</h2>
        </div>
        <ProcessCards steps={SOLUTION_STEPS} labelledby="como-title" fit="medium" />
      </div>
    </section>

    <Faq items={s.faq} muted={false} />

    <section class="section section--muted solution-others" aria-labelledby="outras-title">
      <div class="shell solution-others__grid">
        <h2 class="h2" id="outras-title">{copy.others}</h2>
        <ul role="list" class="solution-others__list">
          {others.map((o) => (
            <li>
              <a class="solution-others__link" href={o.path}>
                <span class="solution-others__disc">
                  <ServiceIcon slug={o.slug} class="solution-others__icon" />
                  <span class="solution-others__go" aria-hidden="true"><Icon name="arrow-right" class="solution-others__go-icon" /></span>
                </span>
                <span class="solution-others__name" style={solutionTransition(o.slug)}>{o.disc ?? o.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <ClosingContact
      title={copy.closing.title}
      text={copy.closing.text}
      subject={s.contact.subject}
      messageLabel={s.contact.label}
      messagePlaceholder={s.contact.placeholder}
      submit={s.hero.cta}
      waMessage={copy.closing.waMessage(s.name)}
    />
  </main>

  <Footer links={footerNav()} />
</Layout>
