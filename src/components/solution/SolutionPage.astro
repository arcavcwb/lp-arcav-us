---
// Página de uma solução da ARCAV: para quem é, o que inclui, o exemplo, como funciona, dúvidas e contato.
// O slot `fit` substitui o bloco "Para quem é / O que está incluído" (usado em Landing pages).
import Layout from '../../layouts/Layout.astro';
import Header from '../ui/Header.astro';
import Footer from '../ui/Footer.astro';
import Icon from '../ui/Icon.astro';
import ExampleFrame from '../ui/ExampleFrame.astro';
import SolutionFlow from './SolutionFlow.astro';
import Faq from '../ui/Faq.astro';
import ClosingContact from '../ui/ClosingContact.astro';
import { SERVICES, SOLUTION_PAGE as copy, SOLUTION_STEPS, type Solution } from '../../data/solutions';
import { ANCHOR, toAnchor } from '../../data/anchors';
import { footerNav } from '../../data/navigation';
import { ui } from '../../data/ui';
import { solutionTransition } from '../../lib/view-transitions';

interface Props {
  solution: Solution;
}

const { solution: s } = Astro.props;
const canonical = new URL(s.path, Astro.site).href;
const others = SERVICES.filter((o) => o.slug !== s.slug);
const contact = toAnchor(ANCHOR.contact);
/** Itens de "Para quem é" e "O que está incluído". */
const fitItem = 'flex gap-3 border-b border-line py-4 text-base font-medium';
---
<Layout title={s.meta.title} description={s.meta.description} canonical={canonical}>
  <Header cta={{ href: contact, label: ui.header.cta }} />

  <main id={ANCHOR.content}>
    <section class="page-hero" aria-labelledby="hero-title">
      <div class="shell page-hero__grid xl:grid-cols-hero-wide">
        <div>
          <h1 class="h1" id="hero-title" style={solutionTransition(s.slug)}>{s.hero.title}</h1>
          <p class="lead">{s.hero.subtitle}</p>
          <div class="page-hero__actions">
            <a class="btn btn--primary" href={contact}>
              {s.hero.cta}
              <Icon name="arrow-right" />
            </a>
            {s.example.path && <a class="btn btn--ghost" href={s.example.path}>{copy.exampleCta}</a>}
          </div>
          <p class="small hero-note mt-4">{copy.heroNote}</p>
        </div>
        {s.example.path || !s.journey ? (
          <ExampleFrame href={s.example.path} image={s.example.image} client={s.example.client} eager />
        ) : (
          <SolutionFlow solution={s} />
        )}
      </div>
    </section>

    {Astro.slots.has('fit') ? <slot name="fit" /> : (
    <section class="section" aria-label={copy.fit.label}>
      <div class="shell grid gap-split lg:grid-cols-2">
        <div>
          <h2 class="h2">{copy.fit.forWho}</h2>
          <ul role="list" class="mt-6 grid border-t border-ink">
            {s.forWho.map((item) => <li class={fitItem}>{item}</li>)}
          </ul>
        </div>
        <div>
          <h2 class="h2">{copy.fit.includes}</h2>
          <ul role="list" class="mt-6 grid border-t border-ink">
            {s.includes.map((item) => <li class={fitItem}><Icon name="check" class="mt-optical-sm size-5 flex-none text-accent" />{item}</li>)}
          </ul>
        </div>
      </div>
    </section>
    )}

    <section class="section section--muted" aria-labelledby="como-title">
      <div class="shell">
        <div class="section-head">
          <h2 class="h2" id="como-title">{copy.how}</h2>
        </div>
        <ol class="steps steps--4 steps--text">
          {SOLUTION_STEPS.map((step) => <li><p>{step}</p></li>)}
        </ol>
      </div>
    </section>

    <Faq items={s.faq} muted={false} />

    <section class="section section--muted" aria-labelledby="outras-title">
      <div class="shell">
        <div class="section-head">
          <h2 class="h2" id="outras-title">{copy.others}</h2>
        </div>
        <ul role="list" class="grid gap-3 lg:grid-cols-2">
          {others.map((o) => (
            <li>
              <a class="flex items-center gap-4 rounded-card border border-line bg-paper px-5 py-4 font-semibold text-ink no-underline transition-colors hover:border-ink" href={o.path}>
                <span class="icon-badge"><Icon name={o.icon} /></span>
                <span class="flex-1">{o.name}</span>
                <Icon name="arrow-right" class="size-4.5 text-muted" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <ClosingContact
      title={copy.closing.title}
      text={copy.closing.text}
      subject={s.contact.subject}
      messageLabel={s.contact.label}
      messagePlaceholder={s.contact.placeholder}
      submit={s.hero.cta}
      waMessage={copy.closing.waMessage(s.name)}
    />
  </main>

  <Footer links={footerNav()} />
</Layout>
