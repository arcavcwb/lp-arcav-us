---
// Tipos de landing page (em /solucoes/landing-pages/), para leigos: escolha o objetivo e veja a ficha
// só daquela página (o caminho do cliente em três frases, para quem é, o que entra e o link).
// Sem JavaScript: cada objetivo é um botão de opção nativo (as setas do teclado trocam a opção) e o
// CSS mostra a ficha da opção marcada (styles/components/solution/landing-flow.css).
import { Icon } from '@components/ui';
import SolutionFlow from './SolutionFlow.astro';
import { LANDING_PICKER as copy, SOLUTIONS } from '@data';
import { solutionTransition } from '@lib';

const pages = SOLUTIONS.filter((s) => s.group === 'landing' && s.journey);
const startIndex = Math.max(0, pages.findIndex((p) => p.slug === copy.defaultSlug));
const GROUP = 'landing-goal';
---
<fieldset class="landing-flow" data-flow>
  <legend class="visually-hidden">{copy.tabs}</legend>
  {pages.map((p, i) => (
    <Fragment>
      <input class="visually-hidden landing-flow__input" type="radio" name={GROUP} id={`lf-${p.slug}`} value={p.slug} checked={i === startIndex} />
      <label class="landing-flow__option" for={`lf-${p.slug}`}>
        <span class="landing-flow__icon-well">
          <Icon name={p.icon} class="landing-flow__icon" />
        </span>
        <span class="landing-flow__labels">
          <strong class="landing-flow__goal">{p.goal}</strong>
          <span class="landing-flow__type">{`${copy.typePrefix} ${p.label.toLowerCase()}`}</span>
        </span>
      </label>
      <div class="landing-flow__panel" data-panel={p.slug}>
        <div class="landing-flow__name">
          <h3 class="landing-flow__title">{p.name}</h3>
          <p class="landing-flow__tagline">{p.tagline}</p>
        </div>

        <div class="landing-flow__path">
          <SolutionFlow solution={p} bare />
        </div>

        <div class="landing-flow__info">
          <div>
            <h4 class="landing-flow__list-title">{copy.forWho}</h4>
            <ul role="list" class="landing-flow__list">
              {p.forWho.map((item) => <li class="landing-flow__for">{item}</li>)}
            </ul>
          </div>

          <div>
            <h4 class="landing-flow__list-title">{copy.includes}</h4>
            <ul role="list" class="landing-flow__list">
              {p.includes.slice(0, copy.maxIncludes).map((item) => (
                <li class="landing-flow__include">
                  <Icon name="check" class="landing-flow__check" />
                  {item}
                </li>
              ))}
            </ul>
          </div>

          <a class="link-arrow" href={p.path} style={solutionTransition(p.slug)}>
            {copy.more}
            <Icon name="arrow-right" />
          </a>
        </div>
      </div>
    </Fragment>
  ))}
</fieldset>
