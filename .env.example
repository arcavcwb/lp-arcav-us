# Integración con Vikunja VPS
VIKUNJA_URL=https://vikunja.arcav.us
VIKUNJA_API_TOKEN=tu_token_de_vikunja_aqui
# Opcionales: id del proyecto y timeout por petición en segundos
VIKUNJA_PROJECT_ID=2
VIKUNJA_TIMEOUT=20

# Formulario de contacto: POST /api/contact -> webhook de n8n (ver docs/contacto.md)
# Local: copiar a .dev.vars (ignorado por git). Producción: secretos del Worker en Cloudflare.
# Obligatoria, https. Sin ella el endpoint responde 503 not_configured.
N8N_CONTACT_WEBHOOK_URL=
# Opcional. Si existe se envía como "Authorization: Bearer <token>".
N8N_CONTACT_WEBHOOK_TOKEN=
