<script>
  const MESSAGE = 'Exemplo: num site real, este botão levaria ao cadastro.';
  const VISIBLE_MS = 4500;

  function initDemoCtas(): void {
    const toast = document.querySelector<HTMLElement>('[data-demo-toast]');
    const toastText = document.querySelector<HTMLElement>('[data-demo-toast-text]');
    if (!toast || !toastText) return;

    let hideTimer: number | undefined;
    let clearTimer: number | undefined;

    const hide = (): void => {
      toast.classList.remove('is-visible');
      window.clearTimeout(clearTimer);
      clearTimer = window.setTimeout(() => {
        toastText.textContent = '';
      }, 250);
    };

    const show = (): void => {
      window.clearTimeout(hideTimer);
      window.clearTimeout(clearTimer);
      // Limpa e preenche de novo para o leitor de tela anunciar a cada clique.
      toastText.textContent = '';
      window.requestAnimationFrame(() => {
        toastText.textContent = MESSAGE;
        toast.classList.add('is-visible');
      });
      hideTimer = window.setTimeout(hide, VISIBLE_MS);
    };

    document.querySelectorAll<HTMLButtonElement>('[data-demo-cta]').forEach((button) => {
      button.addEventListener('click', (event: MouseEvent) => {
        event.preventDefault();
        show();
      });
    });

    document.addEventListener('keydown', (event: KeyboardEvent) => {
      if (event.key === 'Escape' && toast.classList.contains('is-visible')) {
        window.clearTimeout(hideTimer);
        hide();
      }
    });
  }

  initDemoCtas();
</script>
