---
// Demo ilustrativa: landing page de produto/lançamento para um app fictício (Agenda Viva,
// agenda online para salões e barbearias). Ação principal: testar grátis por 14 dias;
// ação secundária: falar com a equipe. Nenhum botão navega: ao clicar, aparece um aviso
// de que é um exemplo. O mock do app é HTML/CSS, sem imagens.
import DemoLayout from '../../layouts/DemoLayout.astro';

export const prerender = true;

const fontsHref =
  'https://fonts.googleapis.com/css2?family=Gabarito:wght@500..800&family=Onest:wght@400..700&display=swap';

type ChipTone = 'teal' | 'plum' | 'amber';
type Pro = 'j' | 'r' | 'b';
type SlotIcon = 'check' | 'send' | 'calendar-plus';

interface Slot {
  time: string;
  duration: string;
  client: string;
  service: string;
  pro?: Pro;
  status?: string;
  tone?: ChipTone;
  icon?: SlotIcon;
  free?: boolean;
}

interface Day {
  label: string;
  num: string;
  busy?: boolean;
  today?: boolean;
}

interface Step {
  title: string;
  text: string;
}

interface Plan {
  id: string;
  name: string;
  tagline: string;
  price: string;
  items: string[];
  cta: string;
  featured?: boolean;
}

interface Faq {
  q: string;
  a: string;
}

const week: Day[] = [
  { label: 'Seg', num: '10', busy: true },
  { label: 'Ter', num: '11', busy: true },
  { label: 'Qua', num: '12', busy: true },
  { label: 'Qui', num: '13', busy: true },
  { label: 'Sex', num: '14', today: true },
  { label: 'Sáb', num: '15', busy: true },
  { label: 'Dom', num: '16' },
];

const slots: Slot[] = [
  {
    time: '09:00',
    duration: '45 min',
    client: 'Marina Alves',
    service: 'Corte e escova',
    pro: 'j',
    status: 'Confirmado',
    tone: 'teal',
    icon: 'check',
  },
  {
    time: '10:00',
    duration: '30 min',
    client: 'Carlos Menezes',
    service: 'Barba e acabamento',
    pro: 'r',
    status: 'Lembrete enviado',
    tone: 'plum',
    icon: 'send',
  },
  {
    time: '11:15',
    duration: '2 h',
    client: 'Luana Prado',
    service: 'Coloração',
    pro: 'b',
    status: 'Lembrete enviado',
    tone: 'plum',
    icon: 'send',
  },
  {
    time: '13:30',
    duration: '30 min',
    client: 'Horário livre',
    service: 'Lista de espera avisada',
    free: true,
  },
  {
    time: '14:00',
    duration: '1 h',
    client: 'Patrícia Rocha',
    service: 'Manicure e pedicure',
    pro: 'b',
    status: 'Agendado online',
    tone: 'amber',
    icon: 'calendar-plus',
  },
];

const steps: Step[] = [
  {
    title: 'Cadastre serviços e equipe',
    text: 'Informe o que o salão oferece, quanto tempo leva cada serviço e quem atende em cada dia da semana.',
  },
  {
    title: 'Divulgue seu link de agendamento',
    text: 'Coloque o link na bio das redes sociais, no status do WhatsApp e no cartão do salão. A partir daí, os clientes marcam sozinhos.',
  },
  {
    title: 'Deixe os lembretes com a gente',
    text: 'Cada agendamento ganha um lembrete na véspera, e a equipe acompanha o dia pelo celular, sem caderno e sem planilha.',
  },
];

const plans: Plan[] = [
  {
    id: 'solo',
    name: 'Solo',
    tagline: 'Para quem atende sozinho ou aluga uma cadeira.',
    price: '49',
    items: [
      '1 profissional na agenda',
      'Link de agendamento online',
      'Lembretes automáticos no WhatsApp',
      'Confirmação e remarcação pelo cliente',
    ],
    cta: 'Testar grátis por 14 dias',
  },
  {
    id: 'equipe',
    name: 'Equipe',
    tagline: 'Para salões e barbearias com equipe fixa.',
    price: '89',
    featured: true,
    items: [
      'Até 6 profissionais',
      'Tudo do plano Solo',
      'Agenda do dia para cada profissional',
      'Lista de espera automática',
      'Ficha do cliente com histórico',
    ],
    cta: 'Testar grátis por 14 dias',
  },
  {
    id: 'rede',
    name: 'Rede',
    tagline: 'Para quem tem mais de uma unidade.',
    price: '149',
    items: [
      'Profissionais ilimitados',
      'Tudo do plano Equipe',
      'Várias unidades na mesma conta',
      'Importação da agenda feita por nós',
      'Atendimento prioritário',
    ],
    cta: 'Falar com a equipe',
  },
];

const faqs: Faq[] = [
  {
    q: 'Preciso de um número de WhatsApp só para o salão?',
    a: 'Não. Os lembretes podem sair de um número da Agenda Viva, sempre com o nome do seu salão na mensagem. Se preferir usar o número do próprio salão, a nossa equipe ajuda na configuração.',
  },
  {
    q: 'Meus clientes precisam baixar algum aplicativo?',
    a: 'Não. Eles marcam pelo seu link, que abre direto no navegador do celular, e recebem o lembrete no WhatsApp que já usam no dia a dia.',
  },
  {
    q: 'O que acontece quando o teste grátis termina?',
    a: 'Você escolhe um plano e continua de onde parou, com a agenda e os clientes do jeito que estavam. Como não pedimos cartão no cadastro, nada é cobrado sem você decidir.',
  },
  {
    q: 'Dá para trazer a agenda que eu já uso?',
    a: 'Dá. Você importa a lista de clientes de uma planilha e lança pelo painel os horários que já estão marcados. No plano Rede, a nossa equipe faz a importação para você.',
  },
];
---

<DemoLayout
  title="Agenda Viva: agenda online para salões e barbearias"
  description="Exemplo ilustrativo de landing page de produto criada pela ARCAV: Agenda Viva, app fictício de agendamento online com lembretes automáticos no WhatsApp para salões e barbearias."
  solutionPath="/solucoes/landing-page-produto/"
  fontsHref={fontsHref}
  themeColor="#5a1f6e"
>
  <div class="av">
    <svg class="sprite" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
      <symbol id="av-i-check" viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" /></symbol>
      <symbol id="av-i-send" viewBox="0 0 24 24"><path d="M21 3 10.5 13.5" /><path d="M21 3l-6.5 18-4-7.5L3 9.5 21 3z" /></symbol>
      <symbol id="av-i-bell" viewBox="0 0 24 24"><path d="M6 9a6 6 0 0 1 12 0c0 6.5 2.5 8 2.5 8h-17S6 15.5 6 9z" /><path d="M10.3 20.5a2 2 0 0 0 3.4 0" /></symbol>
      <symbol id="av-i-calendar" viewBox="0 0 24 24"><rect x="3.5" y="5" width="17" height="15.5" rx="2.5" /><path d="M3.5 10h17M8 3v4M16 3v4" /></symbol>
      <symbol id="av-i-calendar-plus" viewBox="0 0 24 24"><rect x="3.5" y="5" width="17" height="15.5" rx="2.5" /><path d="M3.5 10h17M8 3v4M16 3v4M12 13v5M9.5 15.5h5" /></symbol>
      <symbol id="av-i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5" /><path d="M12 7.5V12l3 2" /></symbol>
      <symbol id="av-i-users" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.5" /><path d="M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6M16 4.7a3.5 3.5 0 0 1 0 6.6M18.5 14.5c1.8.8 3 2.8 3 5.5" /></symbol>
      <symbol id="av-i-scissors" viewBox="0 0 24 24"><circle cx="6" cy="6" r="2.75" /><circle cx="6" cy="18" r="2.75" /><path d="M8.1 7.9 20 19.5M8.1 16.1 20 4.5" /></symbol>
      <symbol id="av-i-menu" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16" /></symbol>
      <symbol id="av-i-chevron" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6" /></symbol>
      <symbol id="av-i-arrow" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></symbol>
      <symbol id="av-i-info" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5" /><path d="M12 11v5M12 8h.01" /></symbol>
    </svg>

    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="#inicio">
          <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
            <rect width="32" height="32" rx="9" fill="#5a1f6e" />
            <rect x="8.5" y="9" width="15" height="15" rx="3.5" fill="none" stroke="#ffffff" stroke-width="2" />
            <path d="M8.5 13h15M12.5 7v3.5M19.5 7v3.5" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" />
            <path d="M12.6 18.4l2.4 2.4 4.4-4.4" fill="none" stroke="#efcffb" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span>Agenda Viva</span>
        </a>
        <nav class="nav" aria-label="Seções da página">
          <a href="#funcionalidades">Funcionalidades</a>
          <a href="#como-comecar">Como começar</a>
          <a href="#planos">Planos</a>
          <a href="#duvidas">Dúvidas</a>
        </nav>
        <button type="button" class="btn btn-primary btn-sm" data-demo-cta>Testar grátis</button>
      </div>
    </header>

    <main>
      <!-- Hero -->
      <section class="hero" id="inicio" aria-labelledby="hero-title">
        <div class="shell hero-grid">
          <div class="hero-copy">
            <h1 id="hero-title">Agenda cheia e <span class="hl">menos cadeira vazia</span> por esquecimento.</h1>
            <p class="hero-lede">
              A Agenda Viva recebe agendamentos online a qualquer hora, lembra cada cliente pelo
              WhatsApp e coloca o dia de trabalho da equipe na palma da mão.
            </p>
            <div class="cta-row">
              <button type="button" class="btn btn-primary" data-demo-cta>
                Testar grátis por 14 dias
                <svg class="i" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="#av-i-arrow" /></svg>
              </button>
              <button type="button" class="btn btn-secondary" data-demo-cta>Falar com a equipe</button>
            </div>
            <ul class="assure">
              <li>
                <svg class="i" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="#av-i-check" /></svg>
                Sem cartão de crédito
              </li>
              <li>
                <svg class="i" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="#av-i-check" /></svg>
                Sem fidelidade
              </li>
              <li>
                <svg class="i" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="#av-i-check" /></svg>
                Pronto para usar no mesmo dia
              </li>
            </ul>
          </div>

          <div
            class="hero-visual"
            role="img"
            aria-label="Tela do aplicativo Agenda Viva com a agenda de sexta-feira da equipe: horários com nome do cliente, serviço e status como confirmado, lembrete enviado e agendado online, além de avisos de novo agendamento e de lembrete enviado."
          >
            <div class="stage"></div>

            <div class="phone">
              <div class="screen">
                <span class="island"></span>
                <div class="statusbar">
                  <span>9:41</span>
                  <svg class="sb-icons" viewBox="0 0 68 12" focusable="false">
                    <rect x="0" y="8" width="3" height="4" rx="1" fill="currentColor" />
                    <rect x="4.5" y="6" width="3" height="6" rx="1" fill="currentColor" />
                    <rect x="9" y="3.5" width="3" height="8.5" rx="1" fill="currentColor" />
                    <rect x="13.5" y="1" width="3" height="11" rx="1" fill="currentColor" />
                    <path d="M23.2 4.8a8.6 8.6 0 0 1 11.6 0M25.6 7.4a5.1 5.1 0 0 1 6.8 0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                    <circle cx="29" cy="10.2" r="1.5" fill="currentColor" />
                    <rect x="42.5" y="1" width="21" height="10.5" rx="3" fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.5" />
                    <rect x="44.5" y="3" width="15" height="6.5" rx="1.5" fill="currentColor" />
                    <path d="M65.5 4.6v3.3" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" opacity="0.5" />
                  </svg>
                </div>

                <div class="app-top">
                  <span>
                    <span class="app-salon">Espaço Lírio</span>
                    <span class="app-date">Sexta, 14 de março</span>
                  </span>
                  <span class="app-add">
                    <svg class="i" viewBox="0 0 24 24" focusable="false"><use href="#av-i-calendar-plus" /></svg>
                  </span>
                </div>

                <div class="week">
                  {week.map((day) => (
                    <span class:list={['day', { 'is-today': day.today }]}>
                      <span>{day.label}</span>
                      <b>{day.num}</b>
                      <span class:list={['dot', { 'is-empty': !day.busy && !day.today }]}></span>
                    </span>
                  ))}
                </div>

                <div class="list-head">
                  <span>Agenda da equipe</span>
                  <span class="stack">
                    <span class="pro pro-j">J</span>
                    <span class="pro pro-r">R</span>
                    <span class="pro pro-b">B</span>
                  </span>
                </div>

                <ol class="slots">
                  {slots.map((slot) => (
                    <li class:list={['slot', { 'slot-free': slot.free }]}>
                      <span class="slot-time">
                        <b>{slot.time}</b>
                        <small>{slot.duration}</small>
                      </span>
                      <span class="slot-body">
                        <span class="slot-name">{slot.client}</span>
                        <span class="slot-meta">{slot.service}</span>
                        {slot.status && (
                          <span class:list={['chip', `chip-${slot.tone}`]}>
                            <svg class="i" viewBox="0 0 24 24" focusable="false"><use href={`#av-i-${slot.icon}`} /></svg>
                            {slot.status}
                          </span>
                        )}
                      </span>
                      {slot.pro ? (
                        <span class:list={['pro', `pro-${slot.pro}`]}>{slot.pro.toUpperCase()}</span>
                      ) : (
                        <span class="slot-bell">
                          <svg class="i" viewBox="0 0 24 24" focusable="false"><use href="#av-i-bell" /></svg>
                        </span>
                      )}
                    </li>
                  ))}
                </ol>

                <div class="app-foot">
                  <div class="tabbar">
                    <span class="tab is-on">
                      <svg class="i" viewBox="0 0 24 24" focusable="false"><use href="#av-i-calendar" /></svg>
                      Agenda
                    </span>
                    <span class="tab">
                      <svg class="i" viewBox="0 0 24 24" focusable="false"><use href="#av-i-users" /></svg>
                      Clientes
                    </span>
                    <span class="tab">
                      <svg class="i" viewBox="0 0 24 24" focusable="false"><use href="#av-i-scissors" /></svg>
                      Serviços
                    </span>
                    <span class="tab">
                      <svg class="i" viewBox="0 0 24 24" focusable="false"><use href="#av-i-menu" /></svg>
                      Mais
                    </span>
                  </div>
                  <span class="home-bar"></span>
                </div>
              </div>
            </div>

            <div class="note note-b">
              <span class="note-ico tone-plum">
                <svg class="i" viewBox="0 0 24 24" focusable="false"><use href="#av-i-calendar-plus" /></svg>
              </span>
              <span class="note-body">
                <span class="note-title">Novo agendamento <small>há 2 min</small></span>
                <span class="note-text">Patrícia marcou manicure e pedicure para hoje às 14:00.</span>
              </span>
            </div>

            <div class="note note-a">
              <span class="note-ico tone-teal">
                <svg class="i" viewBox="0 0 24 24" focusable="false"><use href="#av-i-send" /></svg>
              </span>
              <span class="note-body">
                <span class="note-title">Lembrete enviado <small>agora</small></span>
                <span class="note-text">Para Renata Lopes: escova amanhã às 10:00.</span>
              </span>
            </div>
          </div>
        </div>
      </section>

      <!-- Funcionalidades -->
      <section class="section" id="funcionalidades" aria-labelledby="features-title">
        <div class="shell">
          <div class="section-head">
            <h2 id="features-title">Tudo o que acontece entre o agendamento e a cadeira</h2>
            <p>A Agenda Viva assume a parte repetitiva da recepção, e a equipe fica livre para atender bem.</p>
          </div>

          <div class="features">
            <article class="feature">
              <div class="feature-visual" aria-hidden="true">
                <div class="frag fb">
                  <div class="fb-row">
                    <span class="fb-label">Serviço</span>
                    <span class="fb-value">Corte e escova</span>
                  </div>
                  <div class="fb-row">
                    <span class="fb-label">Profissional</span>
                    <span class="fb-value"><span class="pro pro-j pro-sm">J</span>Júlia</span>
                  </div>
                  <div class="fb-slots">
                    <span class="fb-slot">09:00</span>
                    <span class="fb-slot is-taken">09:45</span>
                    <span class="fb-slot is-picked">10:30</span>
                    <span class="fb-slot">11:15</span>
                    <span class="fb-slot is-taken">14:00</span>
                    <span class="fb-slot">14:45</span>
                  </div>
                  <span class="fb-confirm">Confirmar horário das 10:30</span>
                </div>
              </div>
              <div class="feature-text">
                <h3>Agendamento online a qualquer hora</h3>
                <p>Seus clientes escolhem serviço, profissional e horário por um link, até de madrugada, sem esperar alguém atender o telefone.</p>
              </div>
            </article>

            <article class="feature">
              <div class="feature-visual" aria-hidden="true">
                <div class="frag fm">
                  <div class="fm-head">
                    <span class="fm-avatar">EL</span>
                    <span>
                      <b>Espaço Lírio</b>
                      <small>mensagem automática</small>
                    </span>
                  </div>
                  <p class="fm-bubble">
                    Oi, Marina! Passando para lembrar do seu horário amanhã: corte e escova com a Júlia, às 09:00.
                    <span class="fm-time">18:00</span>
                  </p>
                  <div class="fm-replies">
                    <span>Confirmar</span>
                    <span>Remarcar</span>
                  </div>
                </div>
              </div>
              <div class="feature-text">
                <h3>Lembretes automáticos no WhatsApp</h3>
                <p>Na véspera, cada cliente recebe um lembrete e confirma ou remarca com um toque, sem ninguém da recepção precisar ligar.</p>
              </div>
            </article>

            <article class="feature">
              <div class="feature-visual" aria-hidden="true">
                <div class="frag ft">
                  <div class="ft-col">
                    <span class="ft-who"><span class="pro pro-j pro-sm">J</span>Júlia</span>
                    <span class="ft-block tone-plum">Corte<small>09:00</small></span>
                    <span class="ft-block tone-plum">Escova<small>10:00</small></span>
                    <span class="ft-block tone-free">Livre<small>11:00</small></span>
                  </div>
                  <div class="ft-col">
                    <span class="ft-who"><span class="pro pro-r pro-sm">R</span>Rafa</span>
                    <span class="ft-block tone-teal">Corte<small>09:00</small></span>
                    <span class="ft-block tone-teal">Barba<small>10:00</small></span>
                    <span class="ft-block tone-teal">Corte<small>10:30</small></span>
                  </div>
                  <div class="ft-col">
                    <span class="ft-who"><span class="pro pro-b pro-sm">B</span>Bia</span>
                    <span class="ft-block ft-tall tone-amber">Coloração<small>09:00</small></span>
                    <span class="ft-block tone-amber">Manicure<small>11:00</small></span>
                  </div>
                </div>
              </div>
              <div class="feature-text">
                <h3>O dia de cada profissional no celular</h3>
                <p>A equipe abre a agenda e vê os próprios horários, serviços e observações do cliente, sem depender do caderno da recepção.</p>
              </div>
            </article>

            <article class="feature">
              <div class="feature-visual" aria-hidden="true">
                <div class="frag fw">
                  <div class="fw-free">
                    <span class="fw-ico">
                      <svg class="i" viewBox="0 0 24 24" focusable="false"><use href="#av-i-clock" /></svg>
                    </span>
                    <span>
                      <b>Horário liberado</b>
                      <small>Escova, sábado às 15:30</small>
                    </span>
                  </div>
                  <ul class="fw-list">
                    <li>
                      <span class="pro pro-r pro-sm">R</span>
                      <span class="fw-name">Renata Lopes</span>
                      <span class="chip chip-teal">
                        <svg class="i" viewBox="0 0 24 24" focusable="false"><use href="#av-i-check" /></svg>
                        Confirmou
                      </span>
                    </li>
                    <li>
                      <span class="pro pro-j pro-sm">D</span>
                      <span class="fw-name">Diego Faria</span>
                      <span class="chip chip-soft">Avisado</span>
                    </li>
                    <li>
                      <span class="pro pro-b pro-sm">C</span>
                      <span class="fw-name">Camila Reis</span>
                      <span class="chip chip-soft">Na fila</span>
                    </li>
                  </ul>
                </div>
              </div>
              <div class="feature-text">
                <h3>Lista de espera que ocupa os horários vagos</h3>
                <p>Quando alguém desmarca, a Agenda Viva avisa quem está esperando, e o primeiro que aceitar fica com o horário.</p>
              </div>
            </article>
          </div>
        </div>
      </section>

      <!-- Como começar -->
      <section class="section steps-band" id="como-comecar" aria-labelledby="steps-title">
        <div class="shell">
          <div class="section-head">
            <h2 id="steps-title">Do cadastro ao primeiro lembrete no mesmo dia</h2>
            <p>Sem instalação e sem treinamento longo. Dá para configurar tudo pelo celular, entre um atendimento e outro.</p>
          </div>
          <ol class="steps">
            {steps.map((step, index) => (
              <li class="step">
                <span class="step-num" aria-hidden="true">{index + 1}</span>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- Planos -->
      <section class="section" id="planos" aria-labelledby="plans-title">
        <div class="shell">
          <div class="section-head">
            <h2 id="plans-title">Um plano para cada tamanho de salão</h2>
            <p>Todos começam com 14 dias grátis, sem cartão de crédito. Sem fidelidade: troque de plano ou cancele quando quiser.</p>
          </div>

          <div class="plans">
            {plans.map((plan) => (
              <article class:list={['plan', { 'plan-featured': plan.featured }]} aria-labelledby={`plan-${plan.id}`}>
                <div class="plan-head">
                  <h3 id={`plan-${plan.id}`}>{plan.name}</h3>
                  {plan.featured && <span class="plan-badge">Recomendado</span>}
