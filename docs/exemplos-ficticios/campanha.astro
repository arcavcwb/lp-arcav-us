---
// Demo ilustrativa: landing page de campanha para um cliente fictício (Fluent House,
// escola de inglês no Batel). Uma única ação: inscrever-se na aula experimental gratuita.
// O formulário não envia nada; ao validar, mostra um aviso de que é um exemplo.
import DemoLayout from '../../layouts/DemoLayout.astro';

export const prerender = true;

const fontsHref =
  'https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@100..125,600..900&family=Figtree:wght@400..700&display=swap';

const beneficios = [
  {
    titulo: 'Uma turma de verdade, no seu nível',
    texto:
      'Nada de aula montada só para demonstração. Você participa de uma aula regular, com o professor e os alunos daquela turma.',
  },
  {
    titulo: 'Conversa em inglês desde o começo',
    texto:
      'As atividades são em duplas e pequenos grupos, então todo mundo fala. Se travar numa palavra, o professor ajuda na hora.',
  },
  {
    titulo: 'Um papo com o professor no fim',
    texto:
      'Ele indica o nível e os horários que fazem sentido para a sua rotina. Se quiser se matricular, ótimo; se não, tudo bem também.',
  },
];

const passos = [
  {
    titulo: 'Inscrição',
    texto: 'Você preenche o formulário com nome, WhatsApp, nível e o horário que prefere.',
    destaque: false,
  },
  {
    titulo: 'Confirmação pelo WhatsApp',
    texto: 'A equipe da escola manda uma mensagem para combinar o dia e tirar suas dúvidas.',
    destaque: false,
  },
  {
    titulo: 'Aula de 50 minutos',
    texto: 'Chegue uns minutinhos antes para conhecer a escola. O material da aula fica por nossa conta.',
    destaque: true,
  },
];

const perguntas = [
  {
    pergunta: 'A aula experimental é gratuita mesmo?',
    resposta:
      'É, sim. Você não paga nada, não deixa cartão e não precisa assinar contrato nenhum para participar.',
  },
  {
    pergunta: 'Não sei qual é o meu nível. E agora?',
    resposta:
      'Escolha “Não sei” no formulário. Na confirmação pelo WhatsApp, a equipe faz algumas perguntas rápidas e encaixa você na turma mais adequada.',
  },
  {
    pergunta: 'Até quando posso me inscrever?',
    resposta:
      'As inscrições ficam abertas até 15 de dezembro. O dia da aula é combinado com você na confirmação, dentro do período que você escolheu.',
  },
  {
    pergunta: 'Preciso levar alguma coisa?',
    resposta:
      'Não precisa. A escola empresta o material da aula. Se quiser, leve um caderno para anotar o que aprender.',
  },
];
---
<DemoLayout
  title="Fluent House · Aula experimental gratuita"
  description="Exemplo de landing page de campanha: inscrição para uma aula experimental gratuita de inglês numa escola fictícia no Batel, em Curitiba."
  solutionPath="/solucoes/landing-page-campanhas/"
  fontsHref={fontsHref}
  themeColor="#2b2dd3"
>
  <div class="fh">
    <header class="topbar">
      <div class="wrap topbar-inner">
        <p class="brand">
          <svg class="logo" viewBox="0 0 32 32" width="32" height="32" aria-hidden="true" focusable="false">
            <path class="logo-house" d="M16 2 30 13v17H2V13z" />
            <rect class="logo-door" x="12.5" y="19" width="7" height="11" />
          </svg>
          <span>Fluent House</span>
        </p>
        <p class="topbar-place">Batel, Curitiba</p>
      </div>
    </header>

    <main>
      <section class="hero" aria-labelledby="hero-titulo">
        <svg class="deco hero-deco" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
          <path d="M50 4 96 40v56H4V40z" />
        </svg>

        <div class="wrap hero-grid">
          <div class="hero-intro">
            <h1 id="hero-titulo" class="hero-title">
              Experimente uma aula de inglês. <span class="hl">É grátis.</span>
            </h1>
            <p class="hero-lead">
              Uma aula de verdade, numa turma do seu nível, com professor e colegas. Você conhece a
              Fluent House por dentro e decide com calma se quer continuar.
            </p>
          </div>

          <div class="card" id="inscricao">
            <h2 class="card-title" id="inscricao-titulo" tabindex="-1">Inscrição gratuita</h2>
            <p class="card-intro">Leva menos de um minuto. A escola confirma o dia da aula pelo WhatsApp.</p>

            <form class="form" id="inscricao-form" aria-labelledby="inscricao-titulo" novalidate>
              <div class="field" data-field="nome">
                <label class="label" for="campo-nome">Seu nome</label>
                <input
                  class="input"
                  id="campo-nome"
                  name="nome"
                  type="text"
                  autocomplete="name"
                  autocapitalize="words"
                  required
                  aria-describedby="erro-nome"
                />
                <p class="field-error" id="erro-nome"></p>
              </div>

              <div class="field" data-field="whatsapp">
                <label class="label" for="campo-whatsapp">WhatsApp com DDD</label>
                <input
                  class="input"
                  id="campo-whatsapp"
                  name="whatsapp"
                  type="tel"
                  inputmode="tel"
                  autocomplete="tel"
                  required
                  aria-describedby="erro-whatsapp"
                />
                <p class="field-error" id="erro-whatsapp"></p>
              </div>

              <div class="field" data-field="nivel">
                <label class="label" for="campo-nivel">Nível de inglês</label>
                <div class="select-wrap">
                  <select class="input select" id="campo-nivel" name="nivel" required aria-describedby="erro-nivel">
                    <option value="">Selecione</option>
                    <option value="iniciante">Iniciante</option>
                    <option value="intermediario">Intermediário</option>
                    <option value="avancado">Avançado</option>
                    <option value="nao-sei">Não sei</option>
                  </select>
                </div>
                <p class="field-error" id="erro-nivel"></p>
              </div>

              <fieldset class="choice" id="campo-horario" data-field="horario" aria-describedby="erro-horario">
                <legend class="label">Melhor horário</legend>
                <div class="segmented">
                  <label class="seg">
                    <input type="radio" name="horario" value="manha" required />
                    <span>Manhã</span>
                  </label>
                  <label class="seg">
                    <input type="radio" name="horario" value="tarde" />
                    <span>Tarde</span>
                  </label>
                  <label class="seg">
                    <input type="radio" name="horario" value="noite" />
                    <span>Noite</span>
                  </label>
                </div>
                <p class="field-error" id="erro-horario"></p>
              </fieldset>

              <button class="btn btn-submit" type="submit">Quero minha aula experimental</button>
              <p class="form-note">Seu número só é usado para combinar a aula.</p>
            </form>

            <div class="success" id="inscricao-sucesso" hidden>
              <svg class="success-icon" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
                <circle cx="24" cy="24" r="21" />
                <path class="success-check" d="M14.5 24.5 21 31l12.5-13" pathLength="1" />
              </svg>
              <h3 class="success-title" id="sucesso-titulo" tabindex="-1">Tudo certo!</h3>
              <p class="success-text">
                Exemplo: num site real, a escola receberia sua inscrição e confirmaria pelo WhatsApp.
              </p>
              <button class="link-btn" type="button" id="inscricao-refazer">Fazer outra inscrição</button>
            </div>
          </div>

          <dl class="facts">
            <div>
              <dt>Duração</dt>
              <dd>50 minutos</dd>
            </div>
            <div>
              <dt>Onde</dt>
              <dd>Batel, Curitiba</dd>
            </div>
            <div>
              <dt>Inscrições</dt>
              <dd>até 15 de dezembro</dd>
            </div>
          </dl>
        </div>
      </section>

      <section class="section aula" aria-labelledby="aula-titulo">
        <div class="wrap split">
          <div class="split-head">
            <h2 class="section-title" id="aula-titulo">O que acontece na aula</h2>
            <p class="section-lead">É uma aula normal da escola, e você participa como qualquer aluno da turma.</p>
          </div>
          <ul class="points" role="list">
            {beneficios.map((item) => (
              <li class="point">
                <svg class="point-mark" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                  <path d="M10 1.5 18.5 8v10.5h-17V8z" />
                </svg>
                <div>
                  <h3 class="point-title">{item.titulo}</h3>
                  <p class="point-text">{item.texto}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class="section passos" aria-labelledby="passos-titulo">
        <div class="wrap">
          <div class="passos-head">
            <h2 class="section-title" id="passos-titulo">Como funciona</h2>
            <p class="section-lead">Três passos, do formulário até a sala de aula.</p>
          </div>
          <ol class="steps" role="list">
            {passos.map((passo, i) => (
              <li class:list={['step', { 'step--destaque': passo.destaque }]}>
                <span class="step-num"><span class="sr-only">Passo </span>{i + 1}</span>
                <h3 class="step-title">{passo.titulo}</h3>
                <p class="step-text">{passo.texto}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="section faq" aria-labelledby="faq-titulo">
        <div class="wrap split">
          <div class="split-head">
            <h2 class="section-title" id="faq-titulo">Perguntas frequentes</h2>
            <p class="section-lead">O que mais perguntam antes da aula experimental.</p>
          </div>
          <div class="faq-list">
            {perguntas.map((item) => (
              <details class="faq-item">
                <summary>
                  <span>{item.pergunta}</span>
                  <span class="faq-icon" aria-hidden="true"></span>
                </summary>
                <p class="faq-answer">{item.resposta}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="cta-final" aria-labelledby="cta-titulo">
        <svg class="deco cta-deco" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
          <path d="M50 4 96 40v56H4V40z" />
        </svg>
        <div class="wrap cta-inner">
          <div>
            <h2 class="cta-title" id="cta-titulo">Venha fazer uma aula com a gente.</h2>
            <p class="cta-text">
              É gratuita, dura 50 minutos e não tem compromisso. Inscrições abertas até 15 de dezembro.
            </p>
          </div>
          <a class="btn btn-cta" href="#inscricao" data-ir-formulario>Quero minha aula experimental</a>
        </div>
      </section>
    </main>

    <footer class="rodape">
      <div class="wrap rodape-inner">
        <div>
          <p class="brand brand--footer">
            <svg class="logo" viewBox="0 0 32 32" width="32" height="32" aria-hidden="true" focusable="false">
              <path class="logo-house" d="M16 2 30 13v17H2V13z" />
              <rect class="logo-door" x="12.5" y="19" width="7" height="11" />
            </svg>
            <span>Fluent House</span>
          </p>
          <p class="rodape-text">Escola de inglês no Batel, em Curitiba.</p>
        </div>
        <address class="rodape-address">
          Rua Fictícia, s/n · Batel · Curitiba (PR)<br />
          Endereço fictício, usado só neste exemplo.
        </address>
      </div>
    </footer>
  </div>
</DemoLayout>

<style is:global>
  html {
    background-color: #11123a;
  }

  body {
    background-color: #ffffff;
    color: #11123a;
    font-family: 'Figtree', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
  }
</style>

<style>
  /* ---------- Tokens ---------- */
  .fh {
    --fh-blue: #2b2dd3;
    --fh-blue-shade: #2325be;
    --fh-blue-deep: #1b1c96;
    --fh-ink: #11123a;
    --fh-muted: #4a4c72;
    --fh-paper: #eef0ff;
    --fh-white: #ffffff;
    --fh-yellow: #ffd84a;
    --fh-yellow-hover: #ffe47e;
    --fh-on-blue: #e6e7fc;
    --fh-on-blue-muted: #d0d2f8;
    --fh-line: #d6d8f2;
    --fh-field-line: #7a7ca6;
    --fh-error: #b42318;
    --fh-error-bg: #fff4f2;

    --fh-display: 'Archivo', ui-sans-serif, system-ui, sans-serif;
    --fh-body: 'Figtree', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;

    --fh-gutter: clamp(1rem, 0.4rem + 2.6vw, 2.5rem);
    --fh-max: 75rem;
    --fh-section-y: clamp(3.5rem, 2rem + 6vw, 7rem);

    --logo-door: var(--fh-blue);

    overflow-x: clip;
    font-family: var(--fh-body);
    font-size: clamp(1rem, 0.96rem + 0.2vw, 1.0625rem);
    line-height: 1.55;
    color: var(--fh-ink);
  }

  .wrap {
    width: min(100% - 2 * var(--fh-gutter), var(--fh-max));
    margin-inline: auto;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* ---------- Marca ---------- */
  .brand {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-family: var(--fh-display);
    font-weight: 800;
    font-stretch: 112%;
    font-size: 1.1875rem;
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .logo {
    flex: none;
    width: 2rem;
    height: 2rem;
  }

  .logo-house {
    fill: var(--fh-yellow);
  }

  .logo-door {
    fill: var(--logo-door);
  }

  /* ---------- Topo ---------- */
  .topbar {
    background: var(--fh-blue);
    color: var(--fh-white);
  }

  .topbar-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding-block: 1rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.2);
  }

  .topbar-place {
    color: var(--fh-on-blue-muted);
    font-size: 0.9375rem;
  }

  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    background: var(--fh-blue);
    color: var(--fh-white);
    padding-block: clamp(1.5rem, 0.6rem + 2vw, 2.5rem) clamp(3rem, 2rem + 4vw, 5.5rem);
  }

  .deco {
    position: absolute;
    z-index: -1;
    fill: var(--fh-blue-shade);
    pointer-events: none;
  }

  .hero-deco {
    width: 18rem;
    right: -7rem;
    bottom: -3rem;
  }

  .hero-grid {
    display: grid;
    gap: clamp(1.75rem, 1.25rem + 2vw, 2.5rem);
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'intro'
      'form'
      'facts';
  }

  .hero-intro {
    grid-area: intro;
  }

  .hero-title {
    font-family: var(--fh-display);
    font-weight: 850;
    font-stretch: 115%;
    font-size: clamp(2.25rem, 1rem + 5.4vw, 4.75rem);
    line-height: 0.98;
    letter-spacing: -0.025em;
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  .hero-title .hl {
    display: block;
    margin-top: 0.08em;
    color: var(--fh-yellow);
  }

  .hero-lead {
    max-width: 36ch;
    margin-top: clamp(1rem, 0.75rem + 1vw, 1.5rem);
    color: var(--fh-on-blue);
    font-size: clamp(1.0625rem, 0.97rem + 0.45vw, 1.3125rem);
    line-height: 1.5;
    text-wrap: pretty;
  }

  .facts {
    grid-area: facts;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border-top: 1px solid rgb(255 255 255 / 0.28);
  }

  .facts > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.75rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.16);
  }

  .facts dt {
    color: var(--fh-on-blue-muted);
    font-size: 0.9375rem;
  }

  .facts dd {
    font-family: var(--fh-display);
    font-weight: 750;
    font-stretch: 105%;
    font-size: clamp(1.0625rem, 0.98rem + 0.4vw, 1.25rem);
    line-height: 1.2;
    text-align: right;
  }

  @media (min-width: 30rem) {
    .facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
      padding-top: 1.125rem;
    }

    .facts > div {
      display: grid;
      align-content: start;
      gap: 0.25rem;
      padding-block: 0;
      border-bottom: 0;
    }

    .facts dd {
      text-align: left;
    }
  }

  @media (min-width: 60rem) {
    .hero-deco {
      width: clamp(30rem, 42vw, 44rem);
      right: -5%;
      bottom: -24%;
    }

    .hero-grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      grid-template-rows: 1fr auto;
      grid-template-areas:
        'intro form'
        'facts form';
      column-gap: clamp(2.5rem, 5vw, 5rem);
      row-gap: 2.5rem;
    }

    .hero-intro {
      align-self: center;
    }

    .facts {
      align-self: end;
    }

    .card {
      justify-self: end;
    }
  }

  /* ---------- Cartão do formulário ---------- */
  .card {
    grid-area: form;
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 34rem;
    padding: clamp(1.25rem, 0.9rem + 1.4vw, 1.875rem);
    border-radius: 1rem;
    background: var(--fh-white);
    color: var(--fh-ink);
    box-shadow: 0.625rem 0.625rem 0 var(--fh-blue-deep);
    scroll-margin-top: 1rem;
  }

  .card-title {
    font-family: var(--fh-display);
    font-weight: 800;
    font-stretch: 110%;
    font-size: clamp(1.375rem, 1.2rem + 0.6vw, 1.625rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .card-title:focus,
  .success-title:focus {
    outline: none;
  }

  .card-intro {
    margin-top: 0.375rem;
    color: var(--fh-muted);
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  .form {
    display: grid;
    gap: 0.875rem;
    margin-top: 1.25rem;
  }

  .form[hidden] {
    display: none;
  }

  .field {
    display: grid;
    gap: 0.375rem;
  }

  .label {
    font-weight: 650;
    font-size: 0.9375rem;
    line-height: 1.3;
  }

  .input {
    width: 100%;
    min-height: 3rem;
    padding: 0.625rem 0.875rem;
    border: 2px solid var(--fh-field-line);
    border-radius: 0.5rem;
    background: var(--fh-white);
    color: var(--fh-ink);
    font-size: 1rem;
    line-height: 1.3;
  }

  .input:hover {
    border-color: var(--fh-ink);
  }

  .input:focus-visible {
    border-color: var(--fh-blue);
    outline: 3px solid var(--fh-blue);
    outline-offset: 1px;
  }

  .input[aria-invalid='true'] {
    border-color: var(--fh-error);
    background: var(--fh-error-bg);
  }

  .select-wrap {
    position: relative;
  }

  .select-wrap::after {
    content: '';
    position: absolute;
    top: 50%;
    right: 1.125rem;
    width: 0.5rem;
    height: 0.5rem;
    border-right: 2px solid var(--fh-ink);
    border-bottom: 2px solid var(--fh-ink);
    transform: translateY(-70%) rotate(45deg);
    pointer-events: none;
  }

  .select {
    appearance: none;
    padding-right: 2.75rem;
    cursor: pointer;
  }

  .field-error {
    color: var(--fh-error);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .field-error:empty {
    display: none;
  }

  .choice {
    min-inline-size: 0;
    padding: 0;
    border: 0;
  }

  .choice legend {
    padding: 0;
  }

  .segmented {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
    margin-top: 0.375rem;
  }

  .choice .field-error {
    margin-top: 0.375rem;
  }

  .seg {
    position: relative;
    display: block;
  }

  .seg input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .seg span {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0.5rem;
    border: 2px solid var(--fh-field-line);
    border-radius: 0.5rem;
    background: var(--fh-white);
    font-weight: 650;
    text-align: center;
  }

  .seg input:hover + span {
    border-color: var(--fh-ink);
  }

  .seg input:checked + span {
    border-color: var(--fh-blue);
    background: var(--fh-blue);
    color: var(--fh-white);
  }

  .seg input:focus-visible + span {
    outline: 3px solid var(--fh-blue);
    outline-offset: 2px;
  }

  .choice[data-invalid] .seg span {
    border-color: var(--fh-error);
  }

  .form-note {
    color: var(--fh-muted);
    font-size: 0.875rem;
    line-height: 1.4;
    text-align: center;
  }

  /* ---------- Botões ---------- */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.25rem;
    padding: 0.75rem 1.25rem;
    border: 2px solid var(--fh-ink);
    border-radius: 0.75rem;
    background: var(--fh-yellow);
    box-shadow: 0 0.25rem 0 var(--fh-ink);
    color: var(--fh-ink);
    font-family: var(--fh-display);
    font-weight: 800;
    font-stretch: 104%;
