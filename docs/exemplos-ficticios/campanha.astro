</style>

<script>
  const FIELDS = ['nome', 'whatsapp', 'nivel', 'horario'] as const;
  type FieldName = (typeof FIELDS)[number];
  type Validator = (data: FormData) => string;

  const isFieldName = (value: string): value is FieldName =>
    (FIELDS as readonly string[]).includes(value);

  const readText = (data: FormData, name: FieldName): string => {
    const value = data.get(name);
    return typeof value === 'string' ? value.trim() : '';
  };

  /** Só os dígitos do número, sem o 55 do Brasil se a pessoa digitou. */
  const nationalDigits = (value: string): string => {
    const digits = value.replace(/\D/g, '');
    return digits.length > 11 && digits.startsWith('55') ? digits.slice(2) : digits;
  };

  const formatWhatsapp = (value: string): string => {
    const digits = nationalDigits(value);
    if (digits.length !== 10 && digits.length !== 11) return value.trim();
    const local = digits.slice(2);
    const cut = local.length - 4;
    return `(${digits.slice(0, 2)}) ${local.slice(0, cut)}-${local.slice(cut)}`;
  };

  const validators: Record<FieldName, Validator> = {
    nome: (data) => {
      const value = readText(data, 'nome');
      if (value === '') return 'Conte para a gente como você se chama.';
      if (value.length < 2) return 'Escreva pelo menos o seu primeiro nome.';
      return '';
    },
    whatsapp: (data) => {
      const digits = nationalDigits(readText(data, 'whatsapp'));
      if (digits === '') return 'Informe seu WhatsApp para a escola confirmar a aula.';
      if (digits.length < 10 || digits.length > 11) {
        return 'Confira o número: DDD e telefone, como (41) 98765-4321.';
      }
      return '';
    },
    nivel: (data) =>
      readText(data, 'nivel') === '' ? 'Escolha seu nível. Se tiver dúvida, marque “Não sei”.' : '',
    horario: (data) =>
      readText(data, 'horario') === '' ? 'Escolha o período que fica melhor para você.' : '',
  };

  function initForm(
    form: HTMLFormElement,
    success: HTMLElement,
    successTitle: HTMLElement,
    again: HTMLButtonElement,
  ): void {
    let attempted = false;

    const setError = (name: FieldName, message: string): void => {
      const error = document.getElementById(`erro-${name}`);
      if (error) error.textContent = message;

      form.querySelector<HTMLElement>(`[data-field="${name}"]`)?.toggleAttribute('data-invalid', message !== '');

      const control = document.getElementById(`campo-${name}`);
      if (control instanceof HTMLInputElement || control instanceof HTMLSelectElement) {
        if (message !== '') control.setAttribute('aria-invalid', 'true');
        else control.removeAttribute('aria-invalid');
      }
    };

    const focusField = (name: FieldName): void => {
      if (name === 'horario') {
        form.querySelector<HTMLInputElement>('input[name="horario"]')?.focus();
        return;
      }
      document.getElementById(`campo-${name}`)?.focus();
    };

    const fieldFromEvent = (event: Event): FieldName | null => {
      const target = event.target;
      if (!(target instanceof HTMLInputElement || target instanceof HTMLSelectElement)) return null;
      const name = target.name;
      return isFieldName(name) ? name : null;
    };

    // Depois da primeira tentativa: o erro some assim que o campo fica certo
    // e volta a aparecer só quando a pessoa sai do campo.
    form.addEventListener('input', (event) => {
      const name = fieldFromEvent(event);
      if (!attempted || name === null) return;
      if (validators[name](new FormData(form)) === '') setError(name, '');
    });

    form.addEventListener('change', (event) => {
      const name = fieldFromEvent(event);
      if (!attempted || name === null) return;
      setError(name, validators[name](new FormData(form)));
    });

    const whatsapp = document.getElementById('campo-whatsapp');
    if (whatsapp instanceof HTMLInputElement) {
      whatsapp.addEventListener('blur', () => {
        whatsapp.value = formatWhatsapp(whatsapp.value);
      });
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      attempted = true;

      const data = new FormData(form);
      let firstInvalid: FieldName | null = null;

      for (const name of FIELDS) {
        const message = validators[name](data);
        setError(name, message);
        if (message !== '' && firstInvalid === null) firstInvalid = name;
      }

      if (firstInvalid !== null) {
        focusField(firstInvalid);
        return;
      }

      // Exemplo: nada é enviado. Só mostramos a confirmação.
      const firstName = readText(data, 'nome').split(/\s+/)[0] ?? '';
      successTitle.textContent = firstName !== '' ? `Tudo certo, ${firstName}!` : 'Tudo certo!';
      form.hidden = true;
      success.hidden = false;
      successTitle.focus();
    });

    again.addEventListener('click', () => {
      form.reset();
      attempted = false;
      for (const name of FIELDS) setError(name, '');
      success.hidden = true;
      form.hidden = false;
      document.getElementById('campo-nome')?.focus();
    });
  }

  const form = document.getElementById('inscricao-form');
  const success = document.getElementById('inscricao-sucesso');
  const successTitle = document.getElementById('sucesso-titulo');
  const again = document.getElementById('inscricao-refazer');

  if (
    form instanceof HTMLFormElement &&
    success instanceof HTMLElement &&
    successTitle instanceof HTMLElement &&
    again instanceof HTMLButtonElement
  ) {
    initForm(form, success, successTitle, again);
  }

  // CTA final: leva até o formulário e põe o foco no título do cartão.
  const card = document.getElementById('inscricao');
  const cardTitle = document.getElementById('inscricao-titulo');

  document.querySelectorAll<HTMLAnchorElement>('a[data-ir-formulario]').forEach((link) => {
    link.addEventListener('click', (event) => {
      if (!card) return;
      event.preventDefault();
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      card.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
      cardTitle?.focus({ preventScroll: true });
    });
  });
</script>
