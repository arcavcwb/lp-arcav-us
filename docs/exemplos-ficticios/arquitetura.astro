      grid-column: 6 / -1;
    }
  }

  /* Desenhos técnicos */
  .dwg {
    width: 100%;
    height: auto;
  }

  .dwg :is(path, line, rect, circle, polygon, polyline) {
    vector-effect: non-scaling-stroke;
  }

  .poche {
    fill: var(--tinta);
    stroke: none;
  }

  .ln {
    fill: none;
    stroke: var(--tinta);
    stroke-width: 1;
  }

  .fino {
    stroke-width: 0.75;
  }

  .tracejado {
