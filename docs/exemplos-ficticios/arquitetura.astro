    stroke: var(--tinta-2);
    stroke-width: 1;
    stroke-dasharray: 2 5;
  }

  /* O único movimento da página: a luz da manhã entra na sala. */
  @media (prefers-reduced-motion: no-preference) {
    .luz {
      animation: luz-entra 2.4s cubic-bezier(0.16, 1, 0.3, 1) 0.2s both;
