    font-size: clamp(1.1875rem, 1.05rem + 0.45vw, 1.375rem);
    line-height: 1.5;
  }

  .acoes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(1.75rem, 1.5rem + 1vw, 2.25rem);
  }

  @media (max-width: 29.99rem) {
