    letter-spacing: -0.01em;
  }

  .passo p {
    max-width: 60ch;
    color: var(--tinta-2);
    font-size: 1rem;
  }

  @media (min-width: 40rem) {
    .passos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 62rem) {
    .passos {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* Contato */
  .contato__grid {
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 4rem) var(--coluna-gap);
  }

  .contato__intro {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }

  .contato__intro > p {
    max-width: 60ch;
    color: var(--tinta-2);
  }

  .contato__dados {
    margin-top: 0.75rem;
    border-top: 1px solid var(--linha-forte);
  }

  .contato__dados > div {
    padding-block: 0.875rem;
    border-bottom: 1px solid var(--linha-forte);
  }

  .contato__dados dt {
    color: var(--tinta-2);
    font: 500 0.8125rem/1.3 var(--sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .contato__dados dd {
    margin-top: 0.25rem;
    font: 400 1rem/1.45 var(--sans);
  }

  @media (min-width: 62rem) {
    .contato__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .contato__intro {
      grid-column: 1 / span 5;
    }

    .form {
      grid-column: 7 / -1;
    }
  }

  /* Formulário */
  .form {
    display: grid;
    gap: 1.5rem;
    min-width: 0;
  }

  .campo {
    display: grid;
    gap: 0.5rem;
    min-width: 0;
  }

  .campo label {
    color: var(--tinta);
    font: 500 0.9688rem/1.3 var(--sans);
  }

  .opcional {
    color: var(--tinta-2);
    font-weight: 400;
  }

  .campo input,
  .campo select,
  .campo textarea {
    width: 100%;
    min-height: 3.25rem;
    padding: 0.75rem 0.875rem;
    border: 1px solid var(--borda);
    border-radius: 2px;
    background: var(--papel);
    color: var(--tinta);
    font: 400 1.0625rem/1.4 var(--sans);
    caret-color: var(--ipe);
    transition: border-color 0.2s ease;
  }

  .campo textarea {
    min-height: 8rem;
    resize: vertical;
  }

  .campo :is(input, select, textarea):hover {
    border-color: var(--tinta);
  }

  .campo :is(input, select, textarea):focus-visible {
    border-color: var(--tinta);
    outline-offset: 2px;
  }

  .campo :is(input, textarea)::placeholder {
    color: var(--tinta-2);
    opacity: 1;
  }

  .campo [aria-invalid='true'] {
    border-color: var(--erro);
    box-shadow: inset 0 0 0 1px var(--erro);
  }

  .selecao {
    position: relative;
  }

  .selecao select {
    padding-right: 2.75rem;
    appearance: none;
    cursor: pointer;
  }

  .selecao__seta {
    position: absolute;
    top: 50%;
    right: 1rem;
    translate: 0 -50%;
    pointer-events: none;
  }

  .selecao__seta path {
    fill: none;
    stroke: var(--tinta);
    stroke-width: 1.5;
  }

  .dica {
    color: var(--tinta-2);
    font: 400 0.9063rem/1.45 var(--sans);
  }

  .erro {
    color: var(--erro);
    font: 500 0.9375rem/1.4 var(--sans);
  }

  .erro[hidden] {
    display: none;
  }

  .form__envio {
    display: grid;
    gap: 1rem;
    justify-items: start;
    margin-top: 0.25rem;
  }

  .aviso {
    font: 400 1rem/1.5 var(--sans);
  }

  .aviso:not(:empty) {
    padding: 1rem 1.25rem;
    border: 1px solid var(--tinta);
    background: var(--papel);
  }

  /* Rodapé */
  .rodape {
    padding-block: clamp(3rem, 2.5rem + 2vw, 4.5rem);
    background: var(--tinta);
    color: var(--sobre-escuro);
  }

  .rodape__in {
    display: grid;
    gap: 1.75rem var(--coluna-gap);
    align-items: end;
  }

  .rodape__marca {
    font: 300 clamp(2rem, 1.5rem + 2vw, 3rem)/1 var(--sans);
    letter-spacing: -0.02em;
  }

  .rodape__info {
    display: grid;
    gap: 0.75rem 2rem;
    color: var(--sobre-escuro-2);
    font: 400 0.9375rem/1.5 var(--sans);
  }

  .rodape__info p:not(.rodape__aviso) {
    color: var(--sobre-escuro);
  }

  @media (min-width: 40rem) {
    .rodape__info {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .rodape__aviso {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 62rem) {
    .rodape__in {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .rodape__marca {
      grid-column: 1 / span 5;
    }

    .rodape__info {
      grid-column: 7 / -1;
    }
  }
</style>

<script>
  type Controle = HTMLInputElement | HTMLSelectElement;

  interface Regra {
    controle: Controle;
    erro: HTMLElement;
    validar: (valor: string) => string;
  }

  const MENSAGEM_EXEMPLO = 'Exemplo: num site real, este pedido chegaria direto para o atelier.';

  function emailValido(valor: string): boolean {
    return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(valor);
  }

  function whatsappValido(valor: string): boolean {
    if (/[^\d\s()+.-]/.test(valor)) return false;
    const digitos = valor.replace(/\D/g, '');
    return digitos.length >= 10 && digitos.length <= 13;
  }

  function iniciarFormulario(form: HTMLFormElement): void {
    const aviso = form.querySelector<HTMLElement>('[data-aviso]');

    const criarRegra = (id: string, validar: (valor: string) => string): Regra | null => {
      const controle = form.querySelector<Controle>(`#${id}`);
      const erro = form.querySelector<HTMLElement>(`#${id}-erro`);
      return controle && erro ? { controle, erro, validar } : null;
    };

    const regras: Regra[] = [
      criarRegra('contato-nome', (valor) => (valor.length >= 2 ? '' : 'Informe seu nome.')),
      criarRegra('contato-retorno', (valor) => {
        if (!valor) return 'Informe um e-mail ou um WhatsApp para receber a resposta.';
        const valido = valor.includes('@') ? emailValido(valor) : whatsappValido(valor);
        return valido ? '' : 'Confira o contato: use um e-mail como nome@exemplo.com ou um WhatsApp com DDD.';
      }),
      criarRegra('contato-tipo', (valor) => (valor ? '' : 'Escolha o tipo de projeto.')),
    ].filter((regra): regra is Regra => regra !== null);

    let tentouEnviar = false;

    const conferir = (regra: Regra): boolean => {
      const mensagem = regra.validar(regra.controle.value.trim());
      regra.erro.textContent = mensagem;
      regra.erro.hidden = mensagem === '';
      if (mensagem) {
        regra.controle.setAttribute('aria-invalid', 'true');
      } else {
        regra.controle.removeAttribute('aria-invalid');
      }
      return mensagem === '';
    };

    const limparAviso = (): void => {
      if (aviso) aviso.textContent = '';
    };

    for (const regra of regras) {
      const elemento: HTMLElement = regra.controle;
      const tipoEvento = regra.controle instanceof HTMLSelectElement ? 'change' : 'input';
      elemento.addEventListener(tipoEvento, () => {
        limparAviso();
        if (tentouEnviar) conferir(regra);
      });
      elemento.addEventListener('blur', () => {
        if (tentouEnviar) conferir(regra);
      });
    }

    form.querySelector<HTMLTextAreaElement>('#contato-mensagem')?.addEventListener('input', limparAviso);

    form.addEventListener('submit', (evento: SubmitEvent) => {
      evento.preventDefault();
      tentouEnviar = true;

      const invalidas = regras.filter((regra) => !conferir(regra));
      const [primeiraInvalida] = invalidas;
      if (primeiraInvalida) {
        limparAviso();
        primeiraInvalida.controle.focus();
        return;
      }

      if (aviso) {
        aviso.textContent = '';
        window.setTimeout(() => {
          aviso.textContent = MENSAGEM_EXEMPLO;
        }, 60);
      }
    });
  }

  const formulario = document.querySelector<HTMLFormElement>('#contato-form');
  if (formulario) iniciarFormulario(formulario);
</script>
