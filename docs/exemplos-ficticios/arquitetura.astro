    list-style: none;
  }

  .nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.25rem;
    color: var(--tinta);
    font: 400 0.9688rem/1 var(--sans);
    letter-spacing: 0.01em;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
