      align-items: end;
    }

    .projeto--destaque .folha {
      grid-column: 1 / span 8;
    }

    .projeto--destaque .projeto__texto {
      grid-column: 9 / -1;
    }
  }

  /* Processo: uma linha de cotas encadeadas */
  .passos {
    display: grid;
    padding: 0;
    list-style: none;
  }

  .passo {
    position: relative;
    display: grid;
    gap: 0.5rem;
    align-content: start;
    padding: 1.5rem var(--coluna-gap) 2.25rem 0;
    border-top: 1px solid var(--tinta);
  }

  .passo::before,
  .passo:last-child::after {
    content: '';
    position: absolute;
    top: -6px;
    width: 1px;
    height: 13px;
    background: var(--tinta);
    transform: rotate(45deg);
  }

  .passo::before {
    left: 0;
  }

  .passo:last-child::after {
    right: 0;
  }

  .passo__num {
    margin-bottom: 0.75rem;
    color: var(--ipe);
    font: 300 clamp(2.25rem, 1.8rem + 1.5vw, 3rem)/1 var(--sans);
