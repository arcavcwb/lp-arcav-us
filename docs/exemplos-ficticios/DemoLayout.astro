---
// Layout das páginas de exemplo (demos ilustrativas). Cada demo tem o seu próprio estilo
// (é o "cliente" fictício), mas todas mostram a faixa da ARCAV avisando que é um exemplo
// e levando de volta à página da solução. Não são indexadas.
interface Props {
  title: string;
  description: string;
  /** Página da solução na ARCAV (ex.: /solucoes/landing-page-campanhas/). */
  solutionPath: string;
  /** Google Fonts css2 URL opcional para a identidade da demo. */
  fontsHref?: string;
  themeColor?: string;
}

const { title, description, solutionPath, fontsHref, themeColor = '#ffffff' } = Astro.props;
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} · Exemplo ARCAV</title>
  <meta name="description" content={description}>
  <meta name="robots" content="noindex, nofollow">
  <meta name="theme-color" content={themeColor}>
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  {fontsHref && <link rel="preconnect" href="https://fonts.googleapis.com">}
  {fontsHref && <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>}
  {fontsHref && <link rel="stylesheet" href={fontsHref}>}
</head>
<body>
  <div class="arcav-ribbon" role="note">
    <p>
      <strong>Exemplo ilustrativo criado pela ARCAV.</strong>
      <span>Empresa e conteúdo fictícios.</span>
    </p>
    <a href={solutionPath}>Quero uma página assim <span aria-hidden="true">→</span></a>
  </div>
  <slot />
</body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  * {
    margin: 0;
  }

  html {
    -webkit-text-size-adjust: 100%;
  }

  body {
    min-height: 100vh;
    -webkit-font-smoothing: antialiased;
  }

  img,
  svg {
    display: block;
    max-width: 100%;
  }

  input,
  button,
  textarea,
  select {
    font: inherit;
  }
</style>

<style>
  .arcav-ribbon {
    position: relative;
    z-index: 100;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    padding: 0.5rem clamp(1rem, 0.5rem + 2vw, 2.5rem);
    background: #1c1d21;
    color: #f4f4f5;
    font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  .arcav-ribbon p {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.375rem;
  }

  .arcav-ribbon span {
    color: #a9abb2;
  }

  .arcav-ribbon a {
    color: #e7a27f;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .arcav-ribbon a:hover {
    text-decoration: underline;
  }

  .arcav-ribbon a:focus-visible {
    outline: 2px solid #e7a27f;
    outline-offset: 2px;
    border-radius: 4px;
  }
</style>
