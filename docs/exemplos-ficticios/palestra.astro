</style>

<script>
  const EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
  const SUCCESS_MESSAGE = 'Exemplo: num site real, você receberia a confirmação por e-mail.';

  type Rule = {
    input: HTMLInputElement;
    error: HTMLElement;
    check: (value: string) => string;
  };

  function setupForm(form: HTMLFormElement): void {
    const status = form.querySelector<HTMLElement>('[data-form-status]');
    const rules: Rule[] = [];

    const addRule = (id: string, check: Rule['check']): void => {
      const input = form.querySelector<HTMLInputElement>(`#${id}`);
      const error = form.querySelector<HTMLElement>(`#${id}-erro`);
      if (input && error) rules.push({ input, error, check });
    };

    addRule('f-nome', (value) =>
      value.length < 2 ? 'Informe seu nome. Ele vai no seu crachá.' : '',
    );

    addRule('f-email', (value) => {
      if (value === '') return 'Informe seu e-mail. É para ele que a confirmação seria enviada.';
      if (!EMAIL_PATTERN.test(value)) {
        return 'Confira o e-mail. Ele precisa ter o formato nome@empresa.com.br.';
      }
      return '';
    });

    const validate = (rule: Rule): boolean => {
      const message = rule.check(rule.input.value.trim());
      rule.error.textContent = message;
      rule.error.hidden = message === '';
      if (message === '') {
        rule.input.removeAttribute('aria-invalid');
      } else {
        rule.input.setAttribute('aria-invalid', 'true');
      }
      return message === '';
    };

    for (const rule of rules) {
      rule.input.addEventListener('input', () => {
        if (rule.input.getAttribute('aria-invalid') === 'true') validate(rule);
      });
      rule.input.addEventListener('blur', () => {
        if (rule.input.value.trim() !== '') validate(rule);
      });
    }

    form.addEventListener('submit', (event: SubmitEvent) => {
      event.preventDefault();
      if (status) status.textContent = '';

      const invalid = rules.filter((rule) => !validate(rule));
      const first = invalid[0];
      if (first) {
        first.input.focus();
        return;
      }

      // Demonstração: nada é enviado a lugar nenhum.
      if (status) status.textContent = SUCCESS_MESSAGE;
    });
  }

  function setupCalendarNote(): void {
    const button = document.querySelector<HTMLButtonElement>('[data-calendar-toggle]');
    const note = document.getElementById('nota-agenda');
    if (!button || !note) return;

    button.addEventListener('click', () => {
      const isOpen = button.getAttribute('aria-expanded') === 'true';
      button.setAttribute('aria-expanded', String(!isOpen));
      note.hidden = isOpen;
    });
  }

  const form = document.querySelector<HTMLFormElement>('#form-inscricao');
  if (form) setupForm(form);
  setupCalendarNote();
</script>
